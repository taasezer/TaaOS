#!/bin/bash
# =============================================================================
# TaaOS Frameworks & Universal Managers Hook - Torvalds Edition
# =============================================================================
# This hook script installs additional frameworks and package managers that
# require special installation procedures beyond simple apt-get.
# Location: config/hooks/normal/01-frameworks.hook.chroot
# Executed during: chroot stage of live-build
# =============================================================================

set -euo pipefail

# -----------------------------------------------------------------------------
# Color Output Helpers
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[HOOK]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[HOOK]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[HOOK]${NC} $1"
}

log_error() {
    echo -e "${RED}[HOOK]${NC} $1"
}

# =============================================================================
# SECTION 1: FLATPAK & SNAP (Universal Package Managers)
# =============================================================================
install_universal_managers() {
    log_info "Installing Flatpak and Snap..."

    # Install Flatpak and GNOME Software plugin
    apt-get update
    apt-get install -y --no-install-recommends \
        flatpak \
        gnome-software-plugin-flatpak

    # Install Snapd
    apt-get install -y --no-install-recommends \
        snapd

    # Add Flathub repository (the main Flatpak app store)
    log_info "Adding Flathub repository..."
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

    log_success "Flatpak and Snap installed successfully"
}

# =============================================================================
# SECTION 1.5: C/C++ DEVELOPMENT TOOLS
# =============================================================================
install_cpp_tools() {
    log_info "Installing C/C++ development tools..."

    apt-get update
    
    # Core compilers
    log_info "Installing GCC, G++, and build essentials..."
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        cpp \
        make \
        libc6-dev \
        linux-libc-dev

    # Build tools
    log_info "Installing CMake, Ninja, and build systems..."
    apt-get install -y --no-install-recommends \
        cmake \
        ninja-build \
        autoconf \
        automake \
        libtool \
        pkg-config
    
    # Debuggers and analysis tools
    log_info "Installing GDB, Valgrind, and analysis tools..."
    apt-get install -y --no-install-recommends \
        gdb \
        gdbserver \
        valgrind \
        strace \
        ltrace
    
    # Clang/LLVM (alternative compiler)
    log_info "Installing Clang/LLVM..."
    apt-get install -y --no-install-recommends \
        clang \
        llvm \
        lld \
        clang-format \
        clang-tidy
    
    # Cross-compilation tools (for different architectures)
    log_info "Installing cross-compilation tools..."
    apt-get install -y --no-install-recommends \
        gcc-multilib \
        g++-multilib \
        mingw-w64 \
        || log_warning "Cross-compilation tools partially installed"
    
    # Common libraries for C/C++ development
    log_info "Installing common development libraries..."
    apt-get install -y --no-install-recommends \
        libstdc++-12-dev \
        libboost-all-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libjson-c-dev \
        libsqlite3-dev \
        libpthread-stubs0-dev \
        || log_warning "Some dev libraries failed to install"
    
    # Verify installations
    if command -v gcc &> /dev/null && command -v g++ &> /dev/null; then
        local gcc_version g_version
        gcc_version=$(gcc --version | head -1)
        g_version=$(g++ --version | head -1)
        log_success "GCC installed: ${gcc_version}"
        log_success "G++ installed: ${g_version}"
    fi
    
    if command -v cmake &> /dev/null; then
        log_success "CMake installed: $(cmake --version | head -1)"
    fi
    
    if command -v clang &> /dev/null; then
        log_success "Clang installed: $(clang --version | head -1)"
    fi
    
    if command -v x86_64-w64-mingw32-gcc &> /dev/null; then
        log_success "MinGW-w64 installed for Windows cross-compilation"
    fi
    
    log_success "C/C++ development tools installed"
}

# =============================================================================
# SECTION 2: MICROSOFT .NET 8 SDK & RUNTIME
# =============================================================================
install_dotnet() {
    log_info "Installing Microsoft .NET 8 SDK..."

    # Download Microsoft repository GPG key and package source
    log_info "Downloading Microsoft repository configuration..."
    
    # Download the Microsoft package repository configuration
    wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb

    # Install the repository configuration
    log_info "Installing Microsoft repository..."
    dpkg -i /tmp/packages-microsoft-prod.deb

    # Clean up
    rm -f /tmp/packages-microsoft-prod.deb

    # Update package lists to include Microsoft repository
    apt-get update

    # Install .NET 8 SDK and ASP.NET Core Runtime
    log_info "Installing .NET 8 SDK and ASP.NET Core Runtime..."
    apt-get install -y --no-install-recommends \
        dotnet-sdk-8.0 \
        aspnetcore-runtime-8.0

    # Verify installation
    if command -v dotnet &> /dev/null; then
        local dotnet_version
        dotnet_version=$(dotnet --version 2>/dev/null || echo "unknown")
        log_success ".NET SDK installed: ${dotnet_version}"
    else
        log_warning ".NET installation completed but 'dotnet' command not found in PATH"
    fi
}

# =============================================================================
# SECTION 2.5: NODE.JS LTS (Required for n8n)
# =============================================================================
install_nodejs() {
    log_info "Installing Node.js LTS (required for n8n)..."

    # Install curl if not present
    apt-get install -y curl gnupg

    # Add NodeSource repository for Node.js LTS (v20.x)
    log_info "Adding NodeSource repository..."
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -

    # Install Node.js and npm
    log_info "Installing Node.js and npm..."
    apt-get install -y nodejs

    # Update npm to latest version
    log_info "Updating npm to latest version..."
    npm install -g npm@latest || log_warning "npm update failed, using bundled version"

    # Configure npm for better reliability
    npm config set fetch-timeout 300000
    npm config set fetch-retries 5

    # Verify installation
    if command -v node &> /dev/null && command -v npm &> /dev/null; then
        local node_version npm_version
        node_version=$(node --version 2>/dev/null || echo "unknown")
        npm_version=$(npm --version 2>/dev/null || echo "unknown")
        log_success "Node.js installed: ${node_version}, npm: ${npm_version}"
    else
        log_error "Node.js installation failed!"
        exit 1
    fi
}

# =============================================================================
# SECTION 2.6: VISUAL STUDIO CODE (IDE)
# =============================================================================
install_vscode() {
    log_info "Installing Visual Studio Code..."

    # Install dependencies
    apt-get install -y wget gpg apt-transport-https

    # Add Microsoft GPG key
    log_info "Adding Microsoft GPG key..."
    wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft-archive-keyring.gpg

    # Add VS Code repository
    log_info "Adding VS Code repository..."
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-archive-keyring.gpg] https://packages.microsoft.com/repos/vscode stable main" > /etc/apt/sources.list.d/vscode.list

    # Update and install
    apt-get update
    apt-get install -y code

    # Verify installation
    if command -v code &> /dev/null; then
        log_success "VS Code installed successfully"
    else
        log_warning "VS Code installation completed but 'code' command not found"
    fi
    
    # Install useful extensions (will be available after first launch)
    log_info "Creating VS Code extensions installer..."
    cat > /usr/local/bin/vscode-extensions << 'VSCODE_EXT'
#!/bin/bash
# TaaOS VS Code Extensions Installer
echo "Installing recommended VS Code extensions..."
code --install-extension ms-python.python
code --install-extension ms-dotnettools.csharp
code --install-extension rust-lang.rust-analyzer
code --install-extension ms-azuretools.vscode-docker
code --install-extension esbenp.prettier-vscode
code --install-extension pkief.material-icon-theme
code --install-extension dracula-theme.theme-dracula
code --install-extension github.copilot
echo "Extensions installed!"
VSCODE_EXT
    chmod +x /usr/local/bin/vscode-extensions
}

# =============================================================================
# SECTION 3: RUST (Systems Programming Language)
# =============================================================================
install_rust() {
    log_info "Installing Rust compiler and Cargo..."

    # Install Rust compiler and Cargo package manager from Debian repos
    apt-get install -y --no-install-recommends \
        rustc \
        cargo

    # Verify installation
    if command -v rustc &> /dev/null; then
        local rust_version
        rust_version=$(rustc --version 2>/dev/null || echo "unknown")
        log_success "Rust installed: ${rust_version}"
    else
        log_warning "Rust installation completed but 'rustc' command not found"
    fi
}

# =============================================================================
# SECTION 4: DOCKER (Container Platform)
# =============================================================================
install_docker() {
    log_info "Installing Docker and Docker Compose..."

    # Install Docker from Debian repositories
    apt-get install -y --no-install-recommends \
        docker.io \
        docker-compose

    # Enable Docker service to start on boot
    systemctl enable docker || log_warning "Could not enable Docker service (may not be running in chroot)"

    # Verify installation
    if command -v docker &> /dev/null; then
        local docker_version
        docker_version=$(docker --version 2>/dev/null || echo "unknown")
        log_success "Docker installed: ${docker_version}"
    else
        log_warning "Docker installation completed but 'docker' command not found"
    fi
}

# =============================================================================
# CLEANUP
# =============================================================================
cleanup() {
    log_info "Cleaning up..."

    # Clean apt cache to reduce image size
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    log_success "Cleanup completed"
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================
main() {
    echo ""
    echo "=============================================="
    echo "  TaaOS Frameworks & Universal Managers Hook"
    echo "=============================================="
    echo ""

    install_universal_managers
    echo ""

    install_cpp_tools
    echo ""

    install_dotnet
    echo ""

    install_nodejs
    echo ""

    install_vscode
    echo ""

    install_rust
    echo ""

    install_docker
    echo ""

    cleanup
    echo ""

    echo "=============================================="
    echo "  Hook completed successfully!"
    echo "=============================================="
    echo ""
}

# Run main function
main "$@"
