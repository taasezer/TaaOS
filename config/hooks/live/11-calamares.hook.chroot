#!/bin/bash
# =============================================================================
# TaaOS Calamares Installer Hook
# =============================================================================
# This hook delegates to scripts/core/setup-calamares.sh to avoid code
# duplication. The full Calamares configuration is maintained in that script.
# =============================================================================

set -e

echo "=============================================="
echo "[CALAMARES] TaaOS Installer Configuration"
echo "=============================================="

SCRIPT_BASE="/build/scripts/core"

# Delegate to the canonical setup-calamares.sh script
if [ -f "${SCRIPT_BASE}/setup-calamares.sh" ]; then
    echo "[CALAMARES] Delegating to setup-calamares.sh..."
    chmod +x "${SCRIPT_BASE}/setup-calamares.sh"
    bash "${SCRIPT_BASE}/setup-calamares.sh"
else
    echo "[CALAMARES] WARNING: setup-calamares.sh not found at ${SCRIPT_BASE}/"
    echo "[CALAMARES] Calamares installer will not be configured."
    echo "[CALAMARES] Ensure scripts/core/setup-calamares.sh is included in the build."
fi

echo ""
echo "=============================================="
echo "[CALAMARES] Installer hook complete!"
echo "=============================================="
