#!/bin/bash
# =============================================================================
# TaaOS Full Operating System Configuration
# =============================================================================
# This hook configures the system to work as a complete operating system
# including: fstab, hostname, network, users, services, and hardware support
# =============================================================================

# NOTE: No 'set -e' — this hook must complete fully

echo "=============================================="
echo "[OS-CONFIG] TaaOS Full OS Configuration"
echo "=============================================="

# =============================================================================
# SECTION 0: TAAOS SYSTEM COMMANDS INSTALLATION
# =============================================================================
echo "[OS-CONFIG] Installing core TaaOS system commands from /opt/taaos/scripts/system..."
if [ -d "/opt/taaos/scripts/system" ]; then
    for script in /opt/taaos/scripts/system/*.sh; do
        if [ -f "$script" ]; then
            filename=$(basename -- "$script")
            cmdname="${filename%.sh}"
            echo "  -> Installing $cmdname"
            cp "$script" "/usr/local/bin/$cmdname"
            chmod +x "/usr/local/bin/$cmdname"
        fi
    done
else
    echo "[OS-CONFIG] WARNING: /opt/taaos/scripts/system not found. TaaOS custom commands will be missing!"
fi

if [ -d "/opt/taaos/scripts/core" ]; then
    for script in /opt/taaos/scripts/core/taaos-*.sh; do
        if [ -f "$script" ]; then
            filename=$(basename -- "$script")
            cmdname="${filename%.sh}"
            echo "  -> Installing persistence tools: $cmdname"
            cp "$script" "/usr/local/bin/$cmdname"
            chmod +x "/usr/local/bin/$cmdname"
        fi
    done
fi

# =============================================================================
# SECTION 1: SYSTEM IDENTITY
# =============================================================================
echo "[OS-CONFIG] Setting up system identity..."

# Set hostname
echo "taaos" > /etc/hostname

# Configure hosts
cat > /etc/hosts << 'EOF'
127.0.0.1       localhost
127.0.1.1       taaos.localdomain        taaos

# The following lines are desirable for IPv6 capable hosts
::1     localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

# Set timezone (default to UTC, can be changed during install)
ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# Configure locale
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# =============================================================================
# SECTION 2: FILESYSTEM CONFIGURATION
# =============================================================================
echo "[OS-CONFIG] Configuring filesystem support..."

# Ensure fstab exists
touch /etc/fstab

# Create standard directories
mkdir -p /home /mnt /media /opt /srv /var/log /var/spool /var/tmp
chmod 1777 /var/tmp

# Enable periodic TRIM for SSDs
systemctl enable fstrim.timer 2>/dev/null || true

# =============================================================================
# SECTION 3: NETWORK CONFIGURATION
# =============================================================================
echo "[OS-CONFIG] Configuring network..."

# Enable NetworkManager
systemctl enable NetworkManager.service

# Configure networking
cat > /etc/network/interfaces << 'EOF'
# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

# Allow NetworkManager to manage all interfaces
allow-hotplug eth0
iface eth0 inet dhcp

allow-hotplug wlan0
iface wlan0 inet dhcp
EOF

# Enable systemd-networkd as fallback
systemctl enable systemd-networkd.service 2>/dev/null || true

# =============================================================================
# SECTION 4: STORAGE AND DISK MANAGEMENT
# =============================================================================
echo "[OS-CONFIG] Configuring storage management..."

# Enable LVM if installed
if [ -f /etc/lvm/lvm.conf ]; then
    echo "[OS-CONFIG] LVM detected, enabling..."
    systemctl enable lvm2-monitor.service 2>/dev/null || true
fi

# Enable RAID support if installed
if [ -f /etc/mdadm/mdadm.conf ]; then
    echo "[OS-CONFIG] RAID support detected..."
    systemctl enable mdadm.service 2>/dev/null || true
fi

# Enable disk encryption (cryptsetup)
if command -v cryptsetup >/dev/null 2>&1; then
    echo "[OS-CONFIG] Disk encryption support enabled..."
    # cryptsetup is usually triggered by initramfs
fi

# =============================================================================
# SECTION 5: HARDWARE SUPPORT
# =============================================================================
echo "[OS-CONFIG] Configuring hardware support..."

# Enable hardware detection
update-pciids 2>/dev/null || true
update-usbids 2>/dev/null || true

# Enable thermal management
systemctl enable thermald.service 2>/dev/null || true

# Enable CPU frequency scaling
systemctl enable cpufrequtils.service 2>/dev/null || true

# Enable bluetooth
systemctl enable bluetooth.service 2>/dev/null || true

# Enable VM guest services (auto-detect and enable the right one)
echo "[OS-CONFIG] Enabling VM guest services..."
# VirtualBox: guest additions services (only if installed from ISO)
systemctl enable vboxadd.service 2>/dev/null || true
systemctl enable vboxadd-service.service 2>/dev/null || true
# SPICE VDAgent (QEMU/KVM)
systemctl enable spice-vdagentd.service 2>/dev/null || true
# QEMU Guest Agent
systemctl enable qemu-guest-agent.service 2>/dev/null || true

# Ensure VirtualBox in-kernel modules are loaded at boot
if [ -f /etc/modules ]; then
    for mod in vboxguest vboxsf vboxvideo; do
        grep -q "^${mod}$" /etc/modules 2>/dev/null || echo "$mod" >> /etc/modules
    done
fi

# Enable printing (CUPS)
systemctl enable cups.service 2>/dev/null || true

# Enable sound (PulseAudio is a user-level service, starts automatically per-session)
systemctl enable alsa-restore.service 2>/dev/null || true

# =============================================================================
# SECTION 6: SYSTEM SERVICES
# =============================================================================
echo "[OS-CONFIG] Configuring system services..."

# Enable cron
systemctl enable cron.service

# Enable log rotation (timer may not exist on all Debian versions — cron fallback)
systemctl enable logrotate.timer 2>/dev/null || true

# Enable man-db
systemctl enable man-db.service 2>/dev/null || true

# Note: fstrim.timer already enabled in SECTION 2 above

# Enable swap
systemctl enable swap.target 2>/dev/null || true

# =============================================================================
# SECTION 7: SECURITY CONFIGURATION
# =============================================================================
echo "[OS-CONFIG] Configuring security..."

# Enable AppArmor if available
if [ -f /etc/apparmor/parser.conf ]; then
    systemctl enable apparmor.service 2>/dev/null || true
fi

# Configure sudo
cat > /etc/sudoers.d/taaos << 'EOF'
# TaaOS sudo configuration
# Allow members of group sudo to execute any command
%sudo ALL=(ALL:ALL) ALL

# Allow user to use sudo without password (for live mode)
# Comment out for installed system
engineer ALL=(ALL) NOPASSWD: ALL
EOF

chmod 440 /etc/sudoers.d/taaos

# Create sudo group if not exists
getent group sudo >/dev/null || groupadd --system sudo

# =============================================================================
# SECTION 7.1: SYSTEM-WIDE SAFETY BARRIERS
# =============================================================================
echo "[OS-CONFIG] Installing TaaOS safety barriers..."

cat > /etc/profile.d/taaos-safety.sh << 'SAFETY_EOF'
#!/bin/bash
# =============================================================================
# TaaOS Safety Barriers — System-Wide Destructive Command Protection
# =============================================================================
# Loaded automatically via /etc/profile.d/ for all interactive shells.
# Protects against accidental destruction of critical system directories.
# =============================================================================

# Protected system directories — NEVER allow recursive force-delete on these
_TAAOS_PROTECTED_PATHS=("/" "/*" "/home" "/etc" "/usr" "/boot" "/bin" "/sbin" "/lib" "/lib64" "/var" "/root" "/opt" "/srv" "/proc" "/sys" "/dev" "/run" "/tmp")

# Override 'rm' with a safety wrapper
rm() {
    local has_recursive=false
    local has_force=false
    local target_paths=()

    # Parse arguments
    for arg in "$@"; do
        case "$arg" in
            -rf|-fr|-r|-R|--recursive)
                has_recursive=true
                ;;
            -f|--force)
                has_force=true
                ;;
            -*)
                # Check combined flags like -rfv
                if [[ "$arg" == *r* ]] || [[ "$arg" == *R* ]]; then
                    has_recursive=true
                fi
                if [[ "$arg" == *f* ]]; then
                    has_force=true
                fi
                ;;
            *)
                target_paths+=("$arg")
                ;;
        esac
    done

    # Only check if recursive delete is requested
    if $has_recursive; then
        for target in "${target_paths[@]}"; do
            # Resolve to absolute path
            local resolved
            resolved=$(realpath -m "$target" 2>/dev/null || echo "$target")

            for protected in "${_TAAOS_PROTECTED_PATHS[@]}"; do
                if [[ "$resolved" == "$protected" ]]; then
                    echo ""
                    echo -e "\033[1;31m🛑 TaaOS GÜVENLİK ENGELİ\033[0m"
                    echo -e "\033[1;31m   ENGELLENDI: rm $* \033[0m"
                    echo -e "\033[1;33m   Sebep: '$resolved' kritik bir sistem dizinidir.\033[0m"
                    echo -e "\033[1;33m   Bu komut sisteminizi tamamen yok edebilir.\033[0m"
                    echo ""
                    echo -e "\033[0;36m   Eğer gerçekten bunu yapmak istiyorsanız:\033[0m"
                    echo -e "\033[0;36m   /bin/rm $* \033[0m"
                    echo ""
                    return 1
                fi
            done
        done
    fi

    # Safe to proceed — call real rm
    command rm "$@"
}

# Block fork bombs in bash
_taaos_check_forkbomb() {
    local cmd="$1"
    if [[ "$cmd" == *":()"* ]] && [[ "$cmd" == *":|:"* ]]; then
        echo ""
        echo -e "\033[1;31m🛑 TaaOS GÜVENLİK ENGELİ: Fork bomb tespit edildi!\033[0m"
        return 1
    fi
}

# Warn on dangerous dd commands
dd() {
    local output_device=""
    for arg in "$@"; do
        if [[ "$arg" == of=/dev/sd* ]] || [[ "$arg" == of=/dev/nvme* ]] || [[ "$arg" == of=/dev/vd* ]]; then
            output_device="$arg"
        fi
    done

    if [[ -n "$output_device" ]]; then
        echo ""
        echo -e "\033[1;31m⚠️  TaaOS UYARI: dd komutu bir disk cihazına yazıyor!\033[0m"
        echo -e "\033[1;33m   Hedef: $output_device\033[0m"
        echo -e "\033[1;33m   Bu işlem disk üzerindeki TÜM veriyi silecektir!\033[0m"
        echo ""
        read -p "   Devam etmek istediğinize emin misiniz? (evet/hayir): " confirm
        if [[ "$confirm" != "evet" ]]; then
            echo "   İptal edildi."
            return 1
        fi
    fi

    command dd "$@"
}

export -f rm dd 2>/dev/null || true
SAFETY_EOF

chmod 644 /etc/profile.d/taaos-safety.sh
echo "[OS-CONFIG] Safety barriers installed at /etc/profile.d/taaos-safety.sh"


# =============================================================================
# SECTION 8: PACKAGE MANAGEMENT
# =============================================================================
echo "[OS-CONFIG] Configuring package management..."

# Ensure apt is configured
cat > /etc/apt/sources.list << 'EOF'
# Debian 12 (Bookworm) - TaaOS
deb http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
EOF

# Update apt cache
apt-get update 2>/dev/null || true

# =============================================================================
# SECTION 9: KERNEL AND BOOT
# =============================================================================
echo "[OS-CONFIG] Configuring kernel and boot..."

# Configure GRUB for installed system (Plymouth splash on every boot)
cat > /etc/default/grub << 'EOF'
# TaaOS GRUB Configuration
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="TaaOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
EOF

# Ensure initramfs is updated
update-initramfs -u -k all 2>/dev/null || true

# Configure kernel modules
cat > /etc/modules << 'EOF'
# Kernel modules to load at boot
# TaaOS specific modules

# Filesystems
btrfs
f2fs

# Virtualization
kvm
kvm_intel
kvm_amd
virtio
virtio_pci
virtio_blk
virtio_net

# Hardware monitoring
coretemp
nct6775
it87

# ECC memory
edac_core
edac_mc

# Graphics (safe defaults)
# drm
# bochs_drm
EOF

# =============================================================================
# SECTION 10: LOGGING AND MONITORING
# =============================================================================
echo "[OS-CONFIG] Configuring logging and monitoring..."

# Enable systemd-journald
systemctl enable systemd-journald.service

# Configure log rotation
cat > /etc/logrotate.d/taaos << 'EOF'
/var/log/taaos/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 640 root adm
}
EOF

mkdir -p /var/log/taaos

# =============================================================================
# SECTION 11: INSTALLER INTEGRATION & LIVE ENVIRONMENT CLEANUP
# =============================================================================
echo "[OS-CONFIG] Configuring installer integration and cleaning Live desktop..."

# Aggressive cleanup of the Live environment desktop
# Remove default Debian installer shortcuts
echo "[OS-CONFIG] Removing Debian installer shortcuts from Live skeleton..."
rm -f /usr/share/applications/debian-installer-launcher.desktop 2>/dev/null || true
rm -f /usr/share/applications/install-debian.desktop 2>/dev/null || true

# Ensure TaaOS Installer (Calamares) is clearly visible on the Desktop
echo "[OS-CONFIG] Setting up Calamares (Install TaaOS) shortcut on the Desktop..."
mkdir -p /etc/skel/Desktop

# Priority 0: If includes.chroot already placed a working install-taaos.desktop, keep it
if [ -f /etc/skel/Desktop/install-taaos.desktop ] && grep -q "calamares" /etc/skel/Desktop/install-taaos.desktop 2>/dev/null; then
    echo "[OS-CONFIG] install-taaos.desktop already exists (from includes.chroot), keeping it."
# Priority 1: Use custom taaos-installer if setup-calamares.sh created it
elif [ -f /usr/share/applications/taaos-installer.desktop ]; then
    cp /usr/share/applications/taaos-installer.desktop /etc/skel/Desktop/install-taaos.desktop
# Priority 2: Use default calamares.desktop
elif [ -f /usr/share/applications/calamares.desktop ]; then
    cp /usr/share/applications/calamares.desktop /etc/skel/Desktop/install-taaos.desktop
else
    # Fallback: create a desktop entry pointing directly to calamares
    cat > /etc/skel/Desktop/install-taaos.desktop << 'FALLBACK_DESKTOP'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install TaaOS
Name[tr]=TaaOS Kurulumu
Comment=Install TaaOS to your computer
Comment[tr]=TaaOS'u bilgisayarınıza kurun
Icon=calamares
Exec=pkexec calamares
Categories=System;
Terminal=false
StartupNotify=true
FALLBACK_DESKTOP
fi
chmod +x /etc/skel/Desktop/install-taaos.desktop 2>/dev/null || true

# Purge debian-installer-launcher completely as we use Calamares
apt-get remove --purge -y debian-installer-launcher 2>/dev/null || true

# Create installer marker
touch /etc/taaos-live-installer

# Create post-install script
mkdir -p /usr/lib/taaos
cat > /usr/lib/taaos/post-install.sh << 'EOF'
#!/bin/bash
# TaaOS Post-Installation Configuration
# Runs after Calamares completes installation

echo "[TaaOS] Running post-installation configuration..."

# =========================================================================
# STEP 1: Remove live-specific packages (may fail in chroot — tolerate)
# =========================================================================
echo "[TaaOS] Removing live-specific packages..."
apt-get remove --purge -y \
    live-boot \
    live-config \
    live-config-systemd \
    live-boot-doc \
    2>/dev/null || true

# =========================================================================
# STEP 2: Remove Calamares installer completely
# =========================================================================
echo "[TaaOS] Removing Calamares installer..."
apt-get remove --purge -y calamares calamares-settings-debian 2>/dev/null || true
apt-get -q -y autoremove 2>/dev/null || true

# Remove ALL installer desktop shortcuts (TaaOS + Debian + Calamares)
rm -f /usr/share/applications/taaos-installer.desktop
rm -f /usr/share/applications/calamares.desktop
rm -f /usr/share/applications/debian-installer-launcher.desktop
rm -f /usr/share/applications/install-debian.desktop
rm -f /usr/share/applications/debian-installer.desktop

# Remove installer shortcut from skeleton and user homes (Masaüstü / Desktop)
rm -f /etc/skel/Desktop/install-taaos.desktop 2>/dev/null || true
rm -f /etc/skel/Desktop/Install\ TaaOS.desktop 2>/dev/null || true

# Wildcard sweep: remove ANY remaining installer-related .desktop files across ALL user directories
find /home/ -type f \( -iname "*installer*.desktop" -o -iname "install-taaos.desktop" -o -iname "calamares.desktop" \) -delete 2>/dev/null || true
find /etc/skel/ -type f \( -iname "*installer*.desktop" -o -iname "install-taaos.desktop" -o -iname "calamares.desktop" \) -delete 2>/dev/null || true
find /root/ -type f \( -iname "*installer*.desktop" -o -iname "install-taaos.desktop" -o -iname "calamares.desktop" \) -delete 2>/dev/null || true
find /usr/share/applications -iname "*installer*" -delete 2>/dev/null || true
find /usr/share/applications -iname "*calamares*" -delete 2>/dev/null || true

# Remove Calamares configuration files
rm -rf /etc/calamares

# Remove live-mode LightDM autologin (so installed system boots to login screen)
rm -f /etc/lightdm/lightdm.conf.d/50-taaos-live.conf

echo "[TaaOS] Calamares installer and all shortcuts removed."

# =========================================================================
# STEP 3: Remove the live 'engineer' user (complete cleanup)
# =========================================================================
echo "[TaaOS] Removing live 'engineer' user..."
if id "engineer" >/dev/null 2>&1; then
    # Kill any running processes first
    pkill -u engineer 2>/dev/null || true
    sleep 1
    # Remove the user and home directory
    userdel -rf engineer 2>/dev/null || true
    echo "[TaaOS] User 'engineer' removed."
else
    echo "[TaaOS] User 'engineer' does not exist, skipping."
fi

# Force-remove home directory if it still exists
rm -rf /home/engineer 2>/dev/null || true

# Remove any engineer-specific sudoers files
rm -f /etc/sudoers.d/engineer 2>/dev/null || true
rm -f /etc/sudoers.d/*engineer* 2>/dev/null || true
# Strip any NOPASSWD lines referencing engineer from all sudoers files
sed -i '/engineer.*NOPASSWD/d' /etc/sudoers.d/* 2>/dev/null || true

# Remove crontab for engineer
crontab -u engineer -r 2>/dev/null || true

# Remove live user if exists
if id "live" >/dev/null 2>&1; then
    userdel -rf live 2>/dev/null || true
    rm -rf /home/live 2>/dev/null || true
fi

# =========================================================================
# STEP 4: Fix sudoers — remove NOPASSWD for engineer
# =========================================================================
echo "[TaaOS] Securing sudo configuration..."
if [ -f /etc/sudoers.d/taaos ]; then
    # Rewrite sudoers to only keep the group rule, removing engineer NOPASSWD line
    cat > /etc/sudoers.d/taaos << 'SUDOERS'
# TaaOS sudo configuration
# Allow members of group sudo to execute any command
%sudo ALL=(ALL:ALL) ALL
SUDOERS
    chmod 440 /etc/sudoers.d/taaos
fi

echo "[TaaOS] Sudo configuration secured."

# =========================================================================
# STEP 5: Remove installer marker
# =========================================================================
rm -f /etc/taaos-live-installer

# =========================================================================
# STEP 6: GRUB Bootloader Finalization (CRITICAL for persistent install)
# =========================================================================
echo "[TaaOS] Finalizing bootloader configuration..."

# Auto-detect the boot disk (the disk where / is mounted)
ROOT_PART=$(findmnt -no SOURCE / 2>/dev/null || mount | grep ' / ' | awk '{print $1}')
BOOT_DISK=""

if [ -n "$ROOT_PART" ]; then
    # Strip partition number to get the disk (e.g., /dev/sda1 → /dev/sda)
    BOOT_DISK=$(echo "$ROOT_PART" | sed 's/[0-9]*$//' | sed 's/p$//')
    echo "[TaaOS] Detected root partition: $ROOT_PART"
    echo "[TaaOS] Detected boot disk: $BOOT_DISK"
fi

# Write /etc/default/grub for TaaOS
cat > /etc/default/grub << 'GRUBDEFAULT'
# TaaOS GRUB Configuration
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="TaaOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUBDEFAULT

# Determine if we're in EFI or BIOS mode and re-install GRUB accordingly
if [ -d /sys/firmware/efi ]; then
    echo "[TaaOS] EFI mode detected — installing GRUB for EFI..."
    # Find EFI partition
    EFI_DIR="/boot/efi"
    if [ ! -d "$EFI_DIR" ]; then
        mkdir -p "$EFI_DIR"
        # Try to mount EFI partition if not already mounted
        EFI_PART=$(fdisk -l "$BOOT_DISK" 2>/dev/null | grep -i 'EFI' | awk '{print $1}')
        if [ -n "$EFI_PART" ]; then
            mount "$EFI_PART" "$EFI_DIR" 2>/dev/null || true
        fi
    fi
    grub-install --target=x86_64-efi --efi-directory="$EFI_DIR" --bootloader-id=TaaOS --recheck 2>/dev/null || \
    grub-install --target=x86_64-efi --efi-directory="$EFI_DIR" --bootloader-id=TaaOS --removable --recheck 2>/dev/null || \
    echo "[TaaOS] WARNING: EFI GRUB install may have failed"
else
    echo "[TaaOS] BIOS/Legacy mode detected — installing GRUB for BIOS..."
    if [ -n "$BOOT_DISK" ]; then
        grub-install --target=i386-pc --recheck "$BOOT_DISK" 2>/dev/null || \
        grub-install --recheck "$BOOT_DISK" 2>/dev/null || \
        echo "[TaaOS] WARNING: BIOS GRUB install may have failed on $BOOT_DISK"
    else
        echo "[TaaOS] WARNING: Could not detect boot disk for GRUB installation"
        # Fallback: try common disk names
        for disk in /dev/sda /dev/vda /dev/nvme0n1; do
            if [ -b "$disk" ]; then
                echo "[TaaOS] Trying GRUB install on $disk..."
                grub-install --target=i386-pc --recheck "$disk" 2>/dev/null && break || true
            fi
        done
    fi
fi

# Generate GRUB config
echo "[TaaOS] Generating GRUB configuration..."
update-grub 2>/dev/null || grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true

# Verify GRUB config was written
if [ -f /boot/grub/grub.cfg ]; then
    echo "[TaaOS] ✓ GRUB config successfully generated at /boot/grub/grub.cfg"
    grep -c "menuentry" /boot/grub/grub.cfg | xargs -I{} echo "[TaaOS]   {} menu entries found"
else
    echo "[TaaOS] ✗ WARNING: /boot/grub/grub.cfg was NOT generated!"
fi

# Update initramfs
update-initramfs -u -k all 2>/dev/null || true

# Enable all services for installed system
systemctl enable NetworkManager 2>/dev/null || true
systemctl enable lightdm 2>/dev/null || true
systemctl enable bluetooth 2>/dev/null || true
systemctl enable cups 2>/dev/null || true

# Clean apt cache
apt-get clean 2>/dev/null || true

echo "[TaaOS] Post-installation complete! System is ready."
EOF

chmod +x /usr/lib/taaos/post-install.sh

# =============================================================================
# COMPLETE
# =============================================================================
echo ""
echo "=============================================="
echo "[OS-CONFIG] Full OS Configuration Complete!"
echo "=============================================="
echo ""
echo "System configured for:"
echo "  - Full disk installation"
echo "  - Hardware support (LVM, RAID, Encryption)"
echo "  - Network connectivity"
echo "  - System services"
echo "  - Security features"
echo ""
