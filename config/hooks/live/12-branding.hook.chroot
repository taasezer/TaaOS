#!/bin/bash
# =============================================================================
# TaaOS Branding & Theme Hook
# =============================================================================
# Configures Plymouth boot splash, XFCE theme, wallpaper, and panel
# Location: config/hooks/normal/12-branding.hook.chroot
# =============================================================================

set -e

echo "=============================================="
echo "[BRANDING] TaaOS Branding Configuration"
echo "=============================================="

# =============================================================================
# SECTION 1: PLYMOUTH BOOT SPLASH
# =============================================================================
echo "[BRANDING] Configuring Plymouth boot splash..."

# Create TaaOS Plymouth theme directory
mkdir -p /usr/share/plymouth/themes/taaos

# Create Plymouth theme script
cat > /usr/share/plymouth/themes/taaos/taaos.plymouth << 'EOF'
[Plymouth Theme]
Name=TaaOS
Description=TaaOS Professional Boot Splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/taaos
ScriptFile=/usr/share/plymouth/themes/taaos/taaos.script
EOF

# Create Plymouth script — macOS-style welcome greetings during boot
cat > /usr/share/plymouth/themes/taaos/taaos.script << 'EOF'
# =============================================================================
# TaaOS Plymouth Theme Script — Premium Boot Experience
# =============================================================================
# Shows logo, multilingual welcome greetings with fade animation,
# and a sleek progress bar during system boot.
# =============================================================================

# Dark gradient background
Window.SetBackgroundTopColor(0.06, 0.06, 0.12);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.06);

# ─── Logo ────────────────────────────────────────────────────────────────
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 80);

# ─── Welcome Greeting ─────────────────────────────────────────────────────
greeting_text = "Hoşgeldin Mühendis";
greeting_image = Image.Text(greeting_text, 0.9, 0.9, 0.9);
greeting_sprite = Sprite(greeting_image);
greeting_sprite.SetX(Window.GetWidth() / 2 - greeting_image.GetWidth() / 2);
greeting_sprite.SetY(Window.GetHeight() / 2 + 40);

# Subtitle sprite (always visible)
subtitle_image = Image.Text("TaaOS — Professional Linux for Engineers", 0.4, 0.4, 0.5);
subtitle_sprite = Sprite(subtitle_image);
subtitle_sprite.SetX(Window.GetWidth() / 2 - subtitle_image.GetWidth() / 2);
subtitle_sprite.SetY(Window.GetHeight() / 2 + 90);

# ─── Progress Bar ────────────────────────────────────────────────────────
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetHeight() / 2 + 140;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.x = progress_box.x + 2;
progress_bar.y = progress_box.y + 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);

fun progress_callback(duration, progress) {
    if (progress_bar.image.GetWidth() != Math.Int(progress_bar.original_image.GetWidth() * progress)) {
        progress_bar.image = progress_bar.original_image.Scale(progress_bar.original_image.GetWidth() * progress, progress_bar.original_image.GetHeight());
        progress_bar.sprite.SetImage(progress_bar.image);
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ─── System Messages ──────────────────────────────────────────────────────
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2 - 100, Window.GetHeight() / 2 + 180, 1);

fun message_callback(text) {
    my_image = Image.Text(text, 0.5, 0.5, 0.6);
    message_sprite.SetImage(my_image);
}

Plymouth.SetMessageFunction(message_callback);
EOF

# Copy logo for Plymouth (if exists)
if [ -f /build/assets/logo.png ]; then
    cp /build/assets/logo.png /usr/share/plymouth/themes/taaos/
fi

# Create simple progress bar images
convert -size 200x16 xc:'#1a1a2e' -fill '#333355' -draw "roundrectangle 0,0 199,15 5,5" /usr/share/plymouth/themes/taaos/progress_box.png 2>/dev/null || \
echo "ImageMagick not available, using fallback progress bar"

convert -size 196x12 xc:'#4cc9f0' -draw "roundrectangle 0,0 195,11 4,4" /usr/share/plymouth/themes/taaos/progress_bar.png 2>/dev/null || \
echo "ImageMagick not available, using fallback progress bar"

# Set TaaOS as default Plymouth theme
if command -v plymouth-set-default-theme &> /dev/null; then
    plymouth-set-default-theme taaos 2>/dev/null || true
fi

# Update initramfs with Plymouth theme
update-initramfs -u 2>/dev/null || true

echo "[BRANDING] Plymouth configuration complete"

# =============================================================================
# SECTION 2: XFCE THEME CONFIGURATION
# =============================================================================
echo "[BRANDING] Configuring XFCE theme..."

# Create default XFCE settings
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml

# XFCE Settings - Window Manager (xfwm4)
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Materia-dark"/>
    <property name="title_font" type="string" value="Fira Sans Bold 10"/>
    <property name="button_layout" type="string" value="O|HMC"/>
  </property>
</channel>
EOF

# XFCE Settings - GTK Theme (xsettings)
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Materia-dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Fira Sans 10"/>
    <property name="MonospaceFontName" type="string" value="Fira Code 10"/>
    <property name="CursorThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
EOF

# XFCE Settings - Desktop (Wallpaper) - covers all screen/monitor name combos
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/taaos/wallpaper.png"/>
        </property>
      </property>
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/taaos/wallpaper.png"/>
        </property>
      </property>
      <property name="monitorVGA-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/taaos/wallpaper.png"/>
        </property>
      </property>
      <property name="monitorHDMI-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/taaos/wallpaper.png"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

echo "[BRANDING] XFCE theme configuration complete"

# Ensure custom panel setup configuration is present by ensuring whiskermenu is installed
echo "[BRANDING] Installing required xfce panel plugins..."
apt-get install -y --no-install-recommends xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin || true

# Set up TaaOS Native Polybar
mkdir -p /etc/skel/.config/polybar
cat > /etc/skel/.config/polybar/config.ini << 'EOF'
[colors]
background = #aa1e1e2e
background-alt = #313244
foreground = #cdd6f4
primary = #89b4fa
secondary = #f5c2e7
alert = #f38ba8
disabled = #6c7086

[bar/taaos]
width = 100%
height = 24pt
radius = 0
background = ${colors.background}
foreground = ${colors.foreground}
padding-left = 1
padding-right = 1
module-margin = 1
separator = |
separator-foreground = ${colors.disabled}

font-0 = "Fira Sans:weight=bold:size=11;2"
font-1 = "Fira Code:size=11;2"

modules-left = xworkspaces xwindow
modules-center = date
modules-right = pulseaudio memory cpu tray

cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true

tray-position = right
tray-padding = 4
tray-background = ${colors.background}

[module/xworkspaces]
type = internal/xworkspaces
label-active = %name%
label-active-background = ${colors.background-alt}
label-active-underline= ${colors.primary}
label-active-padding = 2
label-occupied = %name%
label-occupied-padding = 2
label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-padding = 2
label-empty = %name%
label-empty-foreground = ${colors.disabled}
label-empty-padding = 2

[module/xwindow]
type = internal/xwindow
label = %title:0:40:...%
label-foreground = ${colors.secondary}

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <label-volume>
label-volume = VOL %percentage%%
label-volume-foreground = ${colors.primary}
label-muted = MUTED
label-muted-foreground = ${colors.disabled}

[module/memory]
type = internal/memory
interval = 2
label = RAM %percentage_used%%
label-foreground = ${colors.primary}

[module/cpu]
type = internal/cpu
interval = 2
label = CPU %percentage%%
label-foreground = ${colors.primary}

[module/date]
type = internal/date
interval = 1
date = %H:%M
date-alt = %Y-%m-%d %H:%M:%S
label = %date%
label-foreground = ${colors.foreground}

[settings]
screenchange-reload = true
pseudo-transparency = true
EOF

cat > /etc/skel/.config/polybar/launch.sh << 'EOF'
#!/usr/bin/env bash

# Terminate already running bar instances
killall -q polybar

# Wait until the processes have been shut down
while pgrep -u $UID -x polybar >/dev/null; do sleep 1; done

# Launch TaaOS Polybar
polybar taaos 2>&1 | tee -a /tmp/polybar.log & disown
EOF
chmod +x /etc/skel/.config/polybar/launch.sh

# Autostart Polybar on login
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/polybar.desktop << 'EOF'
[Desktop Entry]
Type=Application
Exec=/home/tahas/.config/polybar/launch.sh
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Polybar
Comment=Starts the native TaaOS Polybar
EOF
# Note: we will run a quick script dynamically on first login to fix the /home/user path for autostart, OR we can launch it from an XFCE startup script. A better cross-user autostart entry:
cat > /etc/skel/.config/autostart/polybar.desktop << 'EOF'
[Desktop Entry]
Type=Application
Exec=bash -c "$HOME/.config/polybar/launch.sh"
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Polybar
Comment=Starts the native TaaOS Polybar
EOF

# Construct BOTTOM DOCK launcher profiles (panel-2)
# plugin-20 is 'showdesktop', so no launcher directory needed for it.

mkdir -p /etc/xdg/xfce4/panel/launcher-21
cat > /etc/xdg/xfce4/panel/launcher-21/dock-terminal.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Terminal
Comment=Use the command line
Exec=xfce4-terminal
Icon=utilities-terminal
Terminal=false
StartupNotify=true
EOF

mkdir -p /etc/xdg/xfce4/panel/launcher-22
cat > /etc/xdg/xfce4/panel/launcher-22/dock-filemanager.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=File Manager
Comment=Browse the file system
Exec=thunar %F
Icon=system-file-manager
Terminal=false
StartupNotify=true
EOF

mkdir -p /etc/xdg/xfce4/panel/launcher-23
cat > /etc/xdg/xfce4/panel/launcher-23/dock-browser.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Web Browser
Comment=Browse the web
Exec=x-www-browser %u
Icon=web-browser
Terminal=false
StartupNotify=true
EOF

mkdir -p /etc/xdg/xfce4/panel/launcher-24
cat > /etc/xdg/xfce4/panel/launcher-24/dock-appfinder.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=App Finder
Comment=Find and launch applications
Exec=xfce4-appfinder
Icon=system-search
Terminal=false
StartupNotify=true
EOF

mkdir -p /etc/xdg/xfce4/panel/launcher-25
cat > /etc/xdg/xfce4/panel/launcher-25/dock-home.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Home
Comment=Open your home folder
Exec=thunar ~/
Icon=user-home
Terminal=false
StartupNotify=true
EOF

echo "[BRANDING] Bottom dock launchers created (Terminal, File Manager, Browser, App Finder, Home)"

# =============================================================================
# SECTION 3: WALLPAPER CONFIGURATION
# =============================================================================
echo "[BRANDING] Configuring wallpaper..."

# Create wallpaper directory
mkdir -p /usr/share/backgrounds/taaos

# STEP 1: Ensure wallpaper exists (includes.chroot should have placed it already)
if [ -f /usr/share/backgrounds/taaos/wallpaper.png ]; then
    echo "[BRANDING] Wallpaper found at target (from includes.chroot)"
elif [ -f /build/assets/wallpaper.png ]; then
    cp /build/assets/wallpaper.png /usr/share/backgrounds/taaos/wallpaper.png
    echo "[BRANDING] Wallpaper copied from /build/assets/"
else
    echo "[BRANDING] WARNING: No wallpaper found! Generating fallback..."
    if command -v convert &> /dev/null; then
        convert -size 1920x1080 \
            -define gradient:direction=South \
            gradient:'#1a1a2e'-'#0a0a14' \
            -fill '#cc0000' -gravity center -pointsize 72 \
            -annotate +0+0 "TaaOS" \
            /usr/share/backgrounds/taaos/wallpaper.png 2>/dev/null || \
        convert -size 1920x1080 xc:'#1a1a2e' /usr/share/backgrounds/taaos/wallpaper.png 2>/dev/null || true
    fi
fi

# STEP 2: Force default Debian wallpaper alternative to point to TaaOS wallpaper
if [ -f /usr/share/backgrounds/taaos/wallpaper.png ]; then
    # Divert the default Debian wallpaper
    dpkg-divert --add --rename --divert /usr/share/desktop-base/active-theme/wallpaper/contents/images/1920x1080.svg.real /usr/share/desktop-base/active-theme/wallpaper/contents/images/1920x1080.svg || true
    ln -sf /usr/share/backgrounds/taaos/wallpaper.png /usr/share/desktop-base/active-theme/wallpaper/contents/images/1920x1080.svg || true
    
    # Also enforce traditional alternatives
    ln -sf /usr/share/backgrounds/taaos/wallpaper.png /etc/alternatives/desktop-background || true
    ln -sf /usr/share/backgrounds/taaos/wallpaper.png /usr/share/images/desktop-base/default || true
    
    echo "[BRANDING] Wallpaper enforced via dpkg-divert and alternatives"
else
    echo "[BRANDING] ERROR: Wallpaper still missing after all attempts!"
fi

echo "[BRANDING] Wallpaper configuration complete"

# =============================================================================
# SECTION 4: PANEL CONFIGURATION
# =============================================================================
echo "[BRANDING] Leaving Panel configuration to pre-configured xfce4-panel.xml in skel..."
# Panel is handled by config/includes.chroot/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
echo "[BRANDING] Panel configuration skipped (using pre-configured file)"

# =============================================================================
# SECTION 5: OS LOGO INJECTION (START MENU & LOGIN SCREEN)
# =============================================================================
echo "[BRANDING] Injecting OS Logo into Whisker Menu and LightDM..."

# STEP 1: Ensure logo exists at target paths (includes.chroot should have placed it)
mkdir -p /usr/share/pixmaps
mkdir -p /usr/share/icons

if [ -f /usr/share/pixmaps/taaos-logo.png ]; then
    echo "[BRANDING] Logo found at target (from includes.chroot)"
    # Ensure icons copy exists too
    cp -n /usr/share/pixmaps/taaos-logo.png /usr/share/icons/taaos-logo.png 2>/dev/null || true
elif [ -f /build/assets/logo.png ]; then
    cp /build/assets/logo.png /usr/share/pixmaps/taaos-logo.png
    cp /build/assets/logo.png /usr/share/icons/taaos-logo.png
    echo "[BRANDING] Logo copied from /build/assets/"
else
    echo "[BRANDING] WARNING: Logo not found! Using system default..."
fi

# Configure Whisker Menu to use TaaOS Logo
mkdir -p /etc/xdg/xfce4/panel
cat > /etc/xdg/xfce4/panel/whiskermenu-1.rc << 'EOF'
button-title=TaaOS
button-icon=/usr/share/pixmaps/taaos-logo.png
EOF

# Configure LightDM GTK Greeter to use TaaOS Wallpaper and Logo
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm-gtk-greeter.conf << 'EOF'
[greeter]
background = /usr/share/backgrounds/taaos/wallpaper.png
theme-name = TaaOS-Dark
icon-theme-name = Papirus-Dark
font-name = Fira Sans 10
default-user-image = /usr/share/pixmaps/taaos-logo.png
indicators = ~host;~spacer;~clock;~spacer;~session;~power
position = 50%,center 50%,center
EOF

# =============================================================================
# SECTION 7: TERMINAL APP LAUNCHERS (Node REPL, Git GUI)
# =============================================================================
echo "[BRANDING] Creating terminal application launchers..."

# Node.js REPL launcher wrapper
cat > /usr/local/bin/taaos-node-repl << 'NODE_EOF'
#!/bin/bash
echo ""
echo -e "\033[1;32m  ⬢ TaaOS Node.js REPL\033[0m"
echo -e "\033[0;36m  Node.js $(node --version 2>/dev/null || echo 'not found') | npm $(npm --version 2>/dev/null || echo 'not found')\033[0m"
echo ""
exec node -i
NODE_EOF
chmod +x /usr/local/bin/taaos-node-repl

# Node.js REPL desktop entry
cat > /usr/share/applications/taaos-node-repl.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Node.js REPL
Name[tr]=Node.js Terminali
Comment=Interactive Node.js JavaScript console
Comment[tr]=Etkileşimli Node.js JavaScript konsolu
Exec=xfce4-terminal -e "/usr/local/bin/taaos-node-repl"
Icon=utilities-terminal
Terminal=false
Categories=Development;IDE;
Keywords=node;javascript;js;repl;console;
EOF

# Git GUI (gitg) desktop entry with proper categorization
if [ -f /usr/share/applications/gitg.desktop ]; then
    # gitg already has a desktop entry, just ensure it's categorized properly
    sed -i 's/Categories=.*/Categories=Development;RevisionControl;/' /usr/share/applications/gitg.desktop 2>/dev/null || true
fi

echo "[BRANDING] Terminal app launchers created (Node REPL, Git GUI)"

# =============================================================================
# COMPLETE
# =============================================================================
echo ""
echo "=============================================="
echo "[BRANDING] TaaOS Branding Complete!"
echo "=============================================="
echo ""
echo "Configured:"
echo "  - Plymouth boot splash (TaaOS theme)"
echo "  - XFCE theme (Materia-dark + Papirus-Dark)"
echo "  - Wallpaper (/usr/share/backgrounds/taaos/)"
echo "  - Panel (dark theme, TaaOS menu)"
echo ""
