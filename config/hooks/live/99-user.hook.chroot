#!/bin/bash
# =============================================================================
# TaaOS User Setup Hook - Torvalds Edition
# =============================================================================
# Final setup hook: creates default user, enables ECC monitoring,
# and ensures skeleton configurations are properly copied to user home.
# Location: config/hooks/live/99-user.hook.chroot
# Executed during: chroot stage of live-build (runs last due to 99- prefix)
# =============================================================================

# NOTE: No 'set -e' — this hook must complete fully

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
MAGENTA='\033[0;35m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[USER]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[USER]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[USER]${NC} $1"
}

# =============================================================================
# SECTION 1: CREATE DEFAULT USER
# =============================================================================
create_user() {
    log_info "Creating default user 'engineer'..."

    # Create user with home directory
    useradd -m -s /bin/bash -c "TaaOS Engineer" engineer || log_warning "User may already exist"

    # Set password (engineer:engineer)
    echo "engineer:engineer" | chpasswd

    # Add user to groups
    usermod -aG sudo,docker,video engineer || log_warning "Some groups may not exist yet"

    # Give passwordless sudo to prevent background scripts from freezing on password prompts
    echo "engineer ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/engineer
    chmod 0440 /etc/sudoers.d/engineer

    log_success "User 'engineer' created with groups: sudo, docker, video and NOPASSWD rights"
}

# =============================================================================
# SECTION 2: ENABLE ECC MONITORING (RASDAEMON)
# =============================================================================
enable_ecc_monitoring() {
    log_info "Enabling ECC memory monitoring (rasdaemon)..."

    # Enable rasdaemon service
    systemctl enable rasdaemon || log_warning "Could not enable rasdaemon (may not be running in chroot)"

    log_success "rasdaemon service enabled"
}

# =============================================================================
# SECTION 3: CLEAN DESKTOP ICONS (CachyOS Zero-Clutter Philosophy)
# =============================================================================
clean_desktop() {
    log_info "Enforcing clean zero-clutter desktop (CachyOS style)..."
    rm -rf /etc/skel/Desktop/* 2>/dev/null || true
    rm -rf /home/engineer/Desktop/* 2>/dev/null || true
    mkdir -p /etc/skel/Desktop /home/engineer/Desktop
}

# =============================================================================
# SECTION 4: COPY CONFIGS TO ENGINEER USER
# =============================================================================
copy_configs_to_user() {
    log_info "Copying unified configurations from skeleton to engineer user..."

    # Ensure skeleton configs exist
    if [ -d /etc/skel/.config ]; then
        mkdir -p /home/engineer/.config
        cp -r /etc/skel/.config/* /home/engineer/.config/ 2>/dev/null || true
    fi

    # Ensure bashrc and profile are synced
    [ -f /etc/skel/.bashrc ] && cp /etc/skel/.bashrc /home/engineer/.bashrc 2>/dev/null || true
    [ -f /etc/skel/.profile ] && cp /etc/skel/.profile /home/engineer/.profile 2>/dev/null || true

    # Fix ownership
    chown -R engineer:engineer /home/engineer/
    chmod -R 755 /home/engineer/.config 2>/dev/null || true

    log_success "Configurations copied to /home/engineer"
}

# =============================================================================
# CLEANUP
# =============================================================================
cleanup() {
    log_info "Cleaning up temporary build artifacts..."
    rm -rf /tmp/taaos-* 2>/dev/null || true
    log_success "Cleanup completed"
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================
main() {
    echo ""
    echo "=================================================="
    echo "  TaaOS User Setup Hook"
    echo "=================================================="
    echo ""

    create_user
    echo ""

    enable_ecc_monitoring
    echo ""

    clean_desktop
    echo ""

    copy_configs_to_user
    echo ""

    cleanup
    echo ""

    echo "=================================================="
    echo "  User Setup Hook completed!"
    echo "=================================================="
    echo "  User:      engineer (password: engineer)"
    echo "  Groups:    sudo, docker, video"
    echo "  Desktop:   CachyOS Zero-Clutter"
    echo "  ECC:       rasdaemon enabled"
    echo ""
}

main "$@"
