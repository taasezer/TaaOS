#!/bin/bash
# =============================================================================
# TaaOS Natural Engine AI Assistant Hook - Torvalds Edition
# =============================================================================
# This hook installs and configures the "Natural Engine" - an AI-powered
# natural language to bash command translator using Ollama.
# Location: config/hooks/normal/02-ai-natural.hook.chroot
# Executed during: chroot stage of live-build
# =============================================================================

set -euo pipefail

# -----------------------------------------------------------------------------
# Color Output Helpers
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[AI-HOOK]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[AI-HOOK]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[AI-HOOK]${NC} $1"
}

log_error() {
    echo -e "${RED}[AI-HOOK]${NC} $1"
}

log_ai() {
    echo -e "${MAGENTA}[NATURAL]${NC} $1"
}

# =============================================================================
# SECTION 1: PYTHON BASE (Heavy ML packages moved to on-demand 'taaos-ai')
# =============================================================================
install_python_deps() {
    log_info "Ensuring base Python environment is available..."
    # Note: Heavy PyTorch, TensorFlow, Scikit-learn, Jupyter are managed
    # on-demand via 'taaos-ai' to keep the base image lightweight.
    apt-get update
    apt-get install -y --no-install-recommends \
        python3-pip \
        python3-dev \
        python3-venv
    log_success "Base Python environment verified"
}

# =============================================================================
# SECTION 2: OLLAMA INSTALLATION
# =============================================================================
install_ollama() {
    log_info "Installing Ollama AI runtime..."

    # Download and run Ollama install script (will fail to start service in chroot, so we catch it)
    curl -fsSL https://ollama.com/install.sh | sh || log_warning "Ollama install returned non-zero (expected in chroot)"

    # Enable Ollama service to start on boot
    log_info "Enabling Ollama service..."
    systemctl enable ollama || log_warning "Could not enable Ollama service (may not be running in chroot)"

    log_success "Ollama installed and enabled"
}

# =============================================================================
# SECTION 3: TAANOS (NATURAL ENGINE) INSTALLATION
# =============================================================================
install_taanos() {
    log_ai "Installing TaaNOS (Natural Engine)..."

    # Release URLs for latest TaaNOS Linux binary
    local TAANOS_RELEASE="https://github.com/taasezer/TaaNOS/releases/latest/download/taanos-linux-amd64"
    local TAANOS_RELEASE_LEGACY="https://github.com/taasezer/TaaNOS/releases/latest/download/taanos-linux"
    local TAANOS_RAW="https://raw.githubusercontent.com/taasezer/TaaNOS/main/bin/taanos-linux-amd64"

    # Check if TaaNOS was injected locally via includes.chroot
    if [ -x /usr/local/bin/taanos ]; then
        log_success "Local TaaNOS binary detected (injected during build). Skipping download."
        ln -sf /usr/local/bin/taanos /usr/local/bin/natural
        return 0
    fi

    log_info "Downloading TaaNOS binary from GitHub..."
    local download_ok=false

    # Try release URL first (preferred, versioned)
    if command -v wget &> /dev/null; then
        if wget -qO /usr/local/bin/taanos "$TAANOS_RELEASE" 2>/dev/null; then
            download_ok=true
        elif wget -qO /usr/local/bin/taanos "$TAANOS_RELEASE_LEGACY" 2>/dev/null; then
            download_ok=true
        elif wget -qO /usr/local/bin/taanos "$TAANOS_RAW" 2>/dev/null; then
            download_ok=true
        fi
    elif command -v curl &> /dev/null; then
        if curl -fsSL -o /usr/local/bin/taanos "$TAANOS_RELEASE" 2>/dev/null; then
            download_ok=true
        elif curl -fsSL -o /usr/local/bin/taanos "$TAANOS_RELEASE_LEGACY" 2>/dev/null; then
            download_ok=true
        elif curl -fsSL -o /usr/local/bin/taanos "$TAANOS_RAW" 2>/dev/null; then
            download_ok=true
        fi
    else
        log_error "Neither wget nor curl found! Cannot download TaaNOS."
        return 1
    fi

    if [ "$download_ok" = false ]; then
        log_error "TaaNOS download failed from all sources!"
        log_warning "You can install manually: taanos init"
        return 1
    fi

    # Make binary executable
    chmod +x /usr/local/bin/taanos

    # Create 'natural' symlink for backward compatibility
    ln -sf /usr/local/bin/taanos /usr/local/bin/natural

    # Verify installation
    if [ -x /usr/local/bin/taanos ]; then
        log_success "TaaNOS installed at /usr/local/bin/taanos"
        log_info "Symlink created: natural -> taanos"
    else
        log_error "TaaNOS installation failed!"
        return 1
    fi
}

# =============================================================================
# SECTION 4: N8N (Moved to on-demand 'taaos-devops' / 'taaos-ai')
# =============================================================================
# n8n is available on-demand to avoid slowing down system builds.

# =============================================================================
# SECTION 5: SHELL INTEGRATION
# =============================================================================
create_shell_integration() {
    log_info "Creating shell integration..."

    # Add alias to system-wide bash profile
    if ! grep -q "alias natural='taanos'" /etc/bash.bashrc; then
    cat >> /etc/bash.bashrc << 'BASHRC_EOF'

# =============================================================================
# TaaOS Natural Engine (TaaNOS) Integration
# =============================================================================
# Quick aliases for TaaNOS
alias natural='taanos'
alias n='taanos'
alias ai='taanos'

# Function for quick AI commands
ask() {
    taanos "$@"
}

# Display TaaOS info on login
if command -v neofetch &> /dev/null; then
    : # neofetch will be called from profile if desired
fi
BASHRC_EOF
    fi

    log_success "Shell integration added"
}

# =============================================================================
# CLEANUP
# =============================================================================
cleanup() {
    log_info "Cleaning up..."
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    log_success "Cleanup completed"
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================
main() {
    echo ""
    echo "=================================================="
    echo "  TaaOS Natural Engine (TaaNOS) Hook"
    echo "=================================================="
    echo ""

    install_python_deps
    echo ""

    install_ollama
    echo ""

    # TaaNOS download is non-fatal: if it fails (no internet in chroot),
    # the user can install it later via manual download
    install_taanos || log_warning "TaaNOS download failed (no internet?). Install manually after boot."
    echo ""

    create_shell_integration
    echo ""

    cleanup
    echo ""

    echo "=================================================="
    echo "  Natural Engine (TaaNOS) Hook completed!"
    echo "=================================================="
    echo ""
    echo "  Usage: taanos \"your request\""
    echo "  Alias: natural, n, ai, ask"
    echo "  Init:  taanos init"
    echo ""
    echo "  n8n available at: http://localhost:5678"
    echo ""
}

# Run main function
main "$@"
