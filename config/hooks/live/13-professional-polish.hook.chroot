#!/bin/bash
# =============================================================================
# TaaOS Professional Polish Hook
# =============================================================================
# Applies custom aliases, fastfetch branding, flatpak configuration,
# and prepares the Welcome Screen script.
# Location: config/hooks/normal/13-professional-polish.hook.chroot
# =============================================================================

set -e

echo "=============================================="
echo "[POLISH] Applying TaaOS Professional Touches"
echo "=============================================="

# 1. TaaOS ASCII Logo for Fastfetch
echo "[POLISH] Creating TaaOS ASCII Logo..."
cat > /etc/taaos-ascii.txt << 'EOF'
               #####################
           ####                     ####
        ###                             ###
      ##       _____________________       ##
     #        /____________________/         #
    #                  / /                    #
   #                  / /  /|                 #
   #                 / /  / /                 #
   #                / /  / /                  #
   #               / /  /_/                   #
   #              / /  / /                    #
    #            / /  / /                    #
     #          / /__/ /                    #
      ##       / _____/                   ##
        ###                            ###
           ####                    ####
               ####################
EOF

# 1.1 Create Custom Fastfetch Configuration
echo "[POLISH] Creating Custom Fastfetch Config..."
cat > /etc/fastfetch.jsonc << 'EOF'
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/etc/taaos-ascii.txt",
    "type": "file",
    "color": {"1": "green", "2": "green", "3": "green", "4": "green", "5": "green", "6": "green", "7": "green", "8": "green", "9": "green"},
    "padding": { "top": 1, "left": 1, "right": 2 }
  },
  "display": {
    "separator": "    ",
    "color": { "keys": "default" }
  },
  "modules": [
    { "type": "os", "key": "OS:" },
    { "type": "kernel", "key": "Kernel:" },
    { "type": "uptime", "key": "Uptime:" },
    { "type": "packages", "key": "Packages:" },
    { "type": "shell", "key": "Shell:" },
    { "type": "display", "key": "Resolution:" },
    { "type": "de", "key": "DE:" },
    { "type": "wm", "key": "WM:" },
    { "type": "wmtheme", "key": "WM Theme:" },
    { "type": "disk", "key": "Disk:" },
    { "type": "cpu", "key": "CPU:" },
    { "type": "gpu", "key": "GPU:" },
    { "type": "memory", "key": "RAM:" },
    { "type": "custom", "key": "AI Engine:", "format": "Natural Engine (llama3.2)" }
  ]
}
EOF

# 1.5 Install Fastfetch manually (not in Bookworm repos)
echo "[POLISH] Downloading and installing fastfetch..."
wget -qO /tmp/fastfetch.deb https://github.com/fastfetch-cli/fastfetch/releases/download/2.35.0/fastfetch-linux-amd64.deb || echo "[WARN] Fastfetch download failed."
if [ -s /tmp/fastfetch.deb ]; then
    dpkg -i /tmp/fastfetch.deb || apt-get install -f -y
    rm -f /tmp/fastfetch.deb
fi

# 2. Append Custom Aliases & Fastfetch to system-wide bashrc
echo "[POLISH] Injecting custom aliases and fastfetch into /etc/bash.bashrc..."

cat >> /etc/bash.bashrc << 'EOF'

# ==========================================
# TaaOS Professional Terminal Settings
# ==========================================
alias update="sudo apt update && sudo apt upgrade -y"
alias ports="sudo netstat -tulanp"
alias ll="ls -la"
alias cls="clear"

# Display system info on shell startup (only for interactive shells)
if [[ $- == *i* ]] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch --config /etc/fastfetch.jsonc
fi
EOF

# 3. Configure Flatpak
echo "[POLISH] Configuring Flatpak Ecosystem..."
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true
fi

# 4. Make UI scripts Executable and cleanup duplicates
echo "[POLISH] Setting permissions for UI scripts and cleaning up..."
if [ -f /usr/local/bin/taaos-welcome.py ]; then
    chmod +x /usr/local/bin/taaos-welcome.py
fi
if [ -f /usr/local/bin/taaos-wallpaper-fix.sh ]; then
    chmod +x /usr/local/bin/taaos-wallpaper-fix.sh
fi
if [ -f /usr/local/bin/taaos-update ]; then
    chmod +x /usr/local/bin/taaos-update
fi

# Remove the default Calamares installer icon from the main menu so only TaaOS Kurulumu remains
if [ -f /usr/share/applications/calamares.desktop ]; then
    rm -f /usr/share/applications/calamares.desktop
fi

echo "[POLISH] Professional touches applied successfully!"
