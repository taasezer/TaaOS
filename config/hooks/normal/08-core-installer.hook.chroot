#!/bin/bash
# =============================================================================
# TaaOS Core Installer Hook
# =============================================================================
# Runs Calamares installer setup
# =============================================================================

set -e

echo "=============================================="
echo "  TaaOS Core Installer Hook"
echo "=============================================="

SCRIPT_BASE="/build/scripts/core"

# Execute Calamares setup
if [ -f "${SCRIPT_BASE}/setup-calamares.sh" ]; then
    echo "[HOOK] Running Calamares installer setup..."
    chmod +x "${SCRIPT_BASE}/setup-calamares.sh"
    bash "${SCRIPT_BASE}/setup-calamares.sh"
else
    echo "[HOOK] Warning: Calamares script not found"
fi

echo ""
echo "=============================================="
echo "  Core Installer Hook - COMPLETE!"
echo "=============================================="
