#!/bin/bash
# =============================================================================
# TaaOS Kernel Setup Hook - CRITICAL for Custom Kernel Boot
# =============================================================================
# This hook runs in the CHROOT stage after kernel packages are installed.
# Its job is to:
#   1. Find the custom TaaOS kernel in /lib/modules/
#   2. Ensure initramfs is generated for it
#   3. Create /boot/vmlinuz and /boot/initrd.img symlinks
# The binary hook (00-copy-kernel.hook.binary) later copies these to /live/
# =============================================================================

set -e

echo "=============================================="
echo "[KERNEL-HOOK] TaaOS Custom Kernel Setup"
echo "=============================================="

# =============================================================================
# STEP 1: Find installed kernels
# =============================================================================
echo "[KERNEL-HOOK] Scanning for installed kernels..."
echo "[KERNEL-HOOK] /lib/modules/ contents:"
ls -la /lib/modules/ 2>/dev/null || echo "No /lib/modules found"
echo "[KERNEL-HOOK] /boot/ contents:"
ls -la /boot/ 2>/dev/null || echo "No /boot found"

# Prefer TaaOS custom kernel (compiled by compile_kernel.sh)
# The custom kernel version contains the git hash but NOT "-taaos" suffix
# because compile_kernel.sh uses LOCALVERSION="-taaos" at package level
KERNEL_VERSION=""

# Search for custom kernel versions in /lib/modules
for ver in $(ls /lib/modules/ 2>/dev/null | sort -rV); do
    # Prefer taaos/custom tagged kernel
    if echo "$ver" | grep -qE "taaos|custom"; then
        KERNEL_VERSION="$ver"
        echo "[KERNEL-HOOK] Found TaaOS custom kernel: $ver"
        break
    fi
done

# If no taaos kernel, use the newest kernel available (highest version)
if [ -z "$KERNEL_VERSION" ]; then
    KERNEL_VERSION=$(ls /lib/modules/ 2>/dev/null | sort -rV | head -1)
    if [ -n "$KERNEL_VERSION" ]; then
        echo "[KERNEL-HOOK] No TaaOS kernel found, using: $KERNEL_VERSION"
    fi
fi

if [ -z "$KERNEL_VERSION" ]; then
    echo "[KERNEL-HOOK] ERROR: No kernel found in /lib/modules/"
    echo "[KERNEL-HOOK] Listing /lib/modules/:"
    ls -la /lib/modules/ || echo "Directory empty or missing"
    exit 1
fi

echo "[KERNEL-HOOK] Selected kernel version: $KERNEL_VERSION"

# =============================================================================
# STEP 2: Locate kernel image
# =============================================================================
echo "[KERNEL-HOOK] Locating kernel image..."

VMLINUZ="/boot/vmlinuz-${KERNEL_VERSION}"
if [ ! -f "$VMLINUZ" ]; then
    echo "[KERNEL-HOOK] vmlinuz-${KERNEL_VERSION} not found, searching..."
    VMLINUZ=$(find /boot -name "vmlinuz*" -type f ! -name "*.old" 2>/dev/null | sort -rV | head -1)
fi

if [ -z "$VMLINUZ" ] || [ ! -f "$VMLINUZ" ]; then
    echo "[KERNEL-HOOK] ERROR: No vmlinuz found in /boot/"
    ls -la /boot/
    exit 1
fi

echo "[KERNEL-HOOK] Kernel image: $VMLINUZ"

# =============================================================================
# STEP 3: Generate initramfs if not exists
# =============================================================================
echo "[KERNEL-HOOK] Checking initramfs..."

INITRD="/boot/initrd.img-${KERNEL_VERSION}"
if [ ! -f "$INITRD" ]; then
    echo "[KERNEL-HOOK] Generating initramfs for ${KERNEL_VERSION}..."
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -c -k "${KERNEL_VERSION}" || {
            echo "[KERNEL-HOOK] update-initramfs failed, trying mkinitramfs..."
            mkinitramfs -o "$INITRD" "${KERNEL_VERSION}" || true
        }
    elif command -v mkinitramfs >/dev/null 2>&1; then
        mkinitramfs -o "$INITRD" "${KERNEL_VERSION}" || true
    else
        echo "[KERNEL-HOOK] WARNING: No initramfs tool found!"
    fi
fi

# Fallback: find any initrd
if [ ! -f "$INITRD" ]; then
    INITRD=$(find /boot -name "initrd*" -type f ! -name "*.old" 2>/dev/null | sort -rV | head -1)
fi

if [ -z "$INITRD" ] || [ ! -f "$INITRD" ]; then
    echo "[KERNEL-HOOK] WARNING: No initrd found - boot may fail without it"
else
    echo "[KERNEL-HOOK] Initrd: $INITRD"
fi

# =============================================================================
# STEP 4: Create /boot symlinks (binary hook reads these)
# =============================================================================
echo "[KERNEL-HOOK] Creating /boot symlinks..."

cd /boot

# Remove old generic symlinks
rm -f vmlinuz initrd.img vmlinuz.old initrd.img.old

# Create new symlinks pointing to the selected kernel
ln -sf "$(basename $VMLINUZ)" vmlinuz
echo "[KERNEL-HOOK] Created: /boot/vmlinuz -> $(basename $VMLINUZ)"

if [ -n "$INITRD" ] && [ -f "$INITRD" ]; then
    ln -sf "$(basename $INITRD)" initrd.img
    echo "[KERNEL-HOOK] Created: /boot/initrd.img -> $(basename $INITRD)"
fi

# =============================================================================
# STEP 5: Verification
# =============================================================================
echo ""
echo "[KERNEL-HOOK] Verification:"
echo "[KERNEL-HOOK] /boot/ symlinks:"
ls -la /boot/vmlinuz /boot/initrd.img 2>/dev/null || echo "[KERNEL-HOOK] Some symlinks missing"
echo ""
echo "[KERNEL-HOOK] All kernel files in /boot/:"
ls -la /boot/vmlinuz* /boot/initrd* 2>/dev/null || echo "[KERNEL-HOOK] Some files missing"

echo ""
echo "=============================================="
echo "[KERNEL-HOOK] Kernel setup completed!"
echo "[KERNEL-HOOK] Kernel: $KERNEL_VERSION"
echo "[KERNEL-HOOK] NOTE: Binary hook will copy these to /live/ for ISO"
echo "=============================================="
