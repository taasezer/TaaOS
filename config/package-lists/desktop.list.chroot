# =============================================================================
# TaaOS Desktop Package List - Torvalds Edition
# =============================================================================
# This file defines all packages to be installed in the live system.
# Location: config/package-lists/desktop.list.chroot
# =============================================================================

# =============================================================================
# SECTION 1: FIRMWARE (CRITICAL for Hardware Support)
# =============================================================================
# These firmware blobs are essential for WiFi, Bluetooth, and other hardware
# to function properly with the mainline kernel.

# Core Linux Firmware
firmware-linux
firmware-linux-nonfree

# Intel WiFi Adapters (iwlwifi driver)
firmware-iwlwifi

# Realtek WiFi/Ethernet Adapters
firmware-realtek

# Atheros/Qualcomm WiFi Adapters
firmware-atheros

# Miscellaneous Non-Free Firmware (various hardware, includes Bluetooth firmware)
firmware-misc-nonfree

# =============================================================================
# SECTION 2: XFCE4 DESKTOP ENVIRONMENT
# =============================================================================
# Lightweight, stable, and highly customizable desktop environment.

# Complete XFCE Desktop Task (meta-package)
task-xfce-desktop

# Display Manager
lightdm

# XFCE4 Additional Plugins and Tools
xfce4-goodies
polybar
rofi

# Terminal Emulator
xfce4-terminal

# Display Management & Utility Scripts
pciutils
x11-xserver-utils

# File Manager and Plugins
thunar
thunar-archive-plugin
mugshot

# =============================================================================
# SECTION 3: CONNECTIVITY
# =============================================================================
# Network and Bluetooth management tools.

# NetworkManager with GTK frontend
network-manager-gnome

# Bluetooth Manager (GTK frontend)
blueman

# Bluetooth Protocol Stack
bluez

# =============================================================================
# SECTION 4: HARDWARE MONITORS
# =============================================================================
# Tools for monitoring hardware health, ECC memory, and system sensors.

# RAS Daemon - ECC Memory Error Monitoring
# Works with CONFIG_EDAC enabled in our custom kernel
rasdaemon

# S.M.A.R.T. Disk Monitoring
smartmontools

# Hardware Sensor Monitoring (CPU temp, fan speeds, voltages)
lm-sensors

# VM Guest Support (dynamic display scaling, clipboard, drag & drop)
# X11 driver for VirtualBox VMSVGA controller (enables xrandr resolution switching)
xserver-xorg-video-vmware

# SPICE/QEMU Guest Support (for KVM/QEMU VMs)
spice-vdagent
qemu-guest-agent

# PulseAudio Volume Control (GUI)
pavucontrol

# Performance Optimization
preload
zram-tools
earlyoom

# UX Polish (Compositor, Notifications, Desktop Widget)
picom
dunst
conky-all

# Developer CLI Tools
fzf
bat

# =============================================================================
# SECTION 5: BASE UTILITIES
# =============================================================================
# Essential command-line tools and development packages.

# Privilege Escalation & Authentication
sudo
mate-polkit

# Download Utilities
wget
curl

# System Monitoring (Interactive Process Viewer)
htop

# System Information Display (Modern fastfetch in Debian 13)
fastfetch

# Build Tools (GCC, Make, etc.)
build-essential
git
sassc
libglib2.0-bin

# Python GTK3, Cairo & Tkinter (Required for TaaOS Radial Wheel & Appearance GUI)
python3-tk
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0

# X11 Utilities (xdpyinfo, xdotool — Radial Wheel & display detection)
x11-utils
xdotool

# Zenity (Fallback dialog for welcome screen)
zenity
