# =============================================================================
# TaaOS Theme Packages - Torvalds Edition
# =============================================================================
# GTK themes, icon packs, fonts, and theming utilities.
# Location: config/package-lists/themes.list.chroot
# =============================================================================

# Material Design GTK Theme
materia-gtk-theme

# Papirus Icon Theme (modern, flat icons)
papirus-icon-theme

# Fira Code Font (monospace with ligatures)
fonts-firacode

# Fira Sans (Required by Polybar)
fonts-fira

# Sans-serif fonts for Polybar/UI (Fira Sans alternative)
fonts-open-sans

# Noto fonts for symbol/icon support in Polybar
fonts-noto-core

# Wallpaper Manager
nitrogen

# XFCE Settings Manager
xfce4-settings

# Plymouth Boot Splash
plymouth
plymouth-themes

# Dialog utilities
zenity
