# =============================================================================
# TaaOS Theme Packages - Torvalds Edition
# =============================================================================
# GTK themes, icon packs, fonts, and theming utilities.
# Location: config/package-lists/themes.list.chroot
# =============================================================================

# Modern dark GTK themes
arc-theme
greybird-gtk-theme

# Papirus Icon Theme (modern, flat icons)
papirus-icon-theme

# Fira Code Font (monospace with ligatures)
fonts-firacode

# Sans-serif fonts for Polybar/UI (Fira Sans alternative)
fonts-open-sans

# Noto & FontAwesome fonts for symbol/icon support in Polybar & Quick Settings
fonts-noto-core
fonts-noto-color-emoji
fonts-font-awesome

# Wallpaper Manager
nitrogen

# XFCE Settings Manager
xfce4-settings

# Plymouth Boot Splash
plymouth
plymouth-themes

# Dialog utilities
zenity
