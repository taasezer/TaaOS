#!/bin/bash
# =============================================================================
# Secret Easter Egg Trigger — Elif
# =============================================================================

# 04012006 dosyasini çalistirir
if command -v 04012006 >/dev/null 2>&1; then
    04012006
else
    # Eger sistem path'inde degilse ayni klasördeki dosyayi çalistirmayi dener
    DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    if [ -f "$DIR/04012006" ]; then
        "$DIR/04012006"
    else
        echo "Easter egg bulunamadi!"
    fi
fi
