#!/bin/bash
# =============================================================================
# TaaOS System Cleaner
# =============================================================================

GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}==============================================${NC}"
echo -e "${GREEN}  TaaOS Sistem Temizleyici${NC}"
echo -e "${CYAN}==============================================${NC}"
echo ""

TOTAL_FREED=0

# 1. APT Cache
echo -e "${YELLOW}[1/5] APT Önbelleği Temizleniyor...${NC}"
BEFORE=$(du -s /var/cache/apt/archives/ 2>/dev/null | awk '{print $1}')
sudo apt-get clean
AFTER=$(du -s /var/cache/apt/archives/ 2>/dev/null | awk '{print $1}')
FREED=$(( (BEFORE - AFTER) / 1024 ))
[ $FREED -gt 0 ] && echo -e "  ${GREEN}→ ${FREED}MB temizlendi${NC}" || echo -e "  → Zaten temiz"

# 2. Orphan Packages
echo -e "\n${YELLOW}[2/5] Yetim Paketler Kaldırılıyor...${NC}"
sudo apt-get autoremove --purge -y 2>/dev/null
echo -e "  ${GREEN}→ Tamamlandı${NC}"

# 3. Old Kernels (keep current)
echo -e "\n${YELLOW}[3/5] Eski Kernel İmajları Kontrol Ediliyor...${NC}"
CURRENT=$(uname -r)
OLD_KERNELS=$(dpkg -l 'linux-image-*' 2>/dev/null | grep '^ii' | awk '{print $2}' | grep -v "$CURRENT" | grep -v "meta" || true)
if [ -n "$OLD_KERNELS" ]; then
    echo "$OLD_KERNELS" | xargs sudo apt-get purge -y 2>/dev/null || true
    echo -e "  ${GREEN}→ Eski kernel'ler temizlendi${NC}"
else
    echo -e "  → Sadece güncel kernel mevcut"
fi

# 4. System Logs (keep last 3 days)
echo -e "\n${YELLOW}[4/5] Eski Loglar Temizleniyor (3 gün öncesi)...${NC}"
sudo journalctl --vacuum-time=3d 2>/dev/null || true
echo -e "  ${GREEN}→ Tamamlandı${NC}"

# 5. Thumbnail Cache
echo -e "\n${YELLOW}[5/5] Küçük Resim Önbelleği Temizleniyor...${NC}"
rm -rf ~/.cache/thumbnails/* 2>/dev/null || true
echo -e "  ${GREEN}→ Tamamlandı${NC}"

echo ""
echo -e "${GREEN}✓ Sistem temizliği tamamlandı!${NC}"
echo -e "${CYAN}Kalan disk alanı:${NC}"
df -h / | tail -1 | awk '{print "  Kullanılan: "$3"  Boş: "$4"  ("$5" dolu)"}'
