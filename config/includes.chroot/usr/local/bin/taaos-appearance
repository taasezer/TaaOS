#!/usr/bin/env python3
# =============================================================================
# TaaOS Appearance & Color Palette Studio (taaos-appearance)
# =============================================================================
# Real-time customization of TaaOS:
#   1. Dark Mode (🌙 Karanlık) & Light Mode (☀️ Aydınlık) Toggle
#   2. Color Palette & Custom Accent Picker (Polybar, Rofi, Wheel, Terminal, GTK)
#   3. Compositor & Window Fluidity Modes (XFWM4 Native Zero-Trail / Picom Glass)
#   4. Polybar Layout Style (Full-Width Bar vs Floating Island Bar)
#   5. Terminal Transparency Level (100% Opaque / 95% Translucent / 85% Glass)
# =============================================================================

import os
import re
import sys
import json
import subprocess
from pathlib import Path

_LOCALE = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en"
IS_TR = _LOCALE.lower().startswith("tr")

def tr(tr_text, en_text):
    return tr_text if IS_TR else en_text

HOME = Path.home()
THEME_JSON = HOME / ".config" / "taaos" / "theme.json"
PICOM_CONF = HOME / ".config" / "picom" / "picom.conf"
POLYBAR_CONF = HOME / ".config" / "polybar" / "config.ini"
ROFI_CONF = HOME / ".config" / "rofi" / "config.rasi"
TERMINAL_RC = HOME / ".config" / "xfce4" / "terminal" / "terminalrc"
GTK_CSS = HOME / ".config" / "gtk-3.0" / "gtk.css"
GTK_SETTINGS = HOME / ".config" / "gtk-3.0" / "settings.ini"
AUTOSTART_PICOM = HOME / ".config" / "autostart" / "picom.desktop"

COLOR_PALETTES = {
    "rosso": {
        "name": tr("🔴 Rosso Corsa (Kırmızı)", "🔴 Rosso Corsa (Red)"),
        "hex": "#D40000"
    },
    "cyan": {
        "name": tr("🩵 Siber Camgöbeği (Cyan)", "🩵 Cyber Cyan"),
        "hex": "#00B4D8"
    },
    "emerald": {
        "name": tr("💚 Matrix Zümrüt (Yeşil)", "💚 Matrix Emerald"),
        "hex": "#10B981"
    },
    "amber": {
        "name": tr("🟠 Kehribar Altın (Turuncu)", "🟠 Amber Gold"),
        "hex": "#F59E0B"
    },
    "purple": {
        "name": tr("💜 Neon Mor (Dracula)", "💜 Neon Purple"),
        "hex": "#A855F7"
    }
}

PICOM_PROFILES = {
    "balanced": """# TaaOS Picom — Balanced TaaOS Mode (Smooth Fades & Soft Shadows)
backend = "xrender";
vsync = false;
fading = true;
fade-in-step = 0.09;
fade-out-step = 0.09;
fade-delta = 3;
shadow = true;
shadow-radius = 12;
shadow-offset-x = -6;
shadow-offset-y = -6;
shadow-opacity = 0.35;
shadow-exclude = [
  "class_g = 'Polybar'",
  "class_g = 'TaaOS Wheel'",
  "_GTK_FRAME_EXTENTS@:c"
];
inactive-opacity = 0.97;
active-opacity = 1.0;
""",
    "ultra": """# TaaOS Picom — Ultra GPU Glass Mode (GLX, Rounded Corners, Shadows & Fades)
backend = "glx";
vsync = true;
fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;
fade-delta = 4;
corner-radius = 10;
rounded-corners-exclude = [
  "class_g = 'Polybar'",
  "window_type = 'dock'",
  "window_type = 'desktop'"
];
shadow = true;
shadow-radius = 14;
shadow-offset-x = -7;
shadow-offset-y = -7;
shadow-opacity = 0.40;
shadow-exclude = [
  "class_g = 'Polybar'",
  "class_g = 'TaaOS Wheel'",
  "_GTK_FRAME_EXTENTS@:c"
];
inactive-opacity = 0.95;
active-opacity = 1.0;
"""
}

def load_theme_state():
    try:
        if THEME_JSON.exists():
            return json.loads(THEME_JSON.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {"accent": "#D40000", "mode": "dark", "picom": "performance", "polybar": "full"}

def save_theme_state(data):
    try:
        THEME_JSON.parent.mkdir(parents=True, exist_ok=True)
        THEME_JSON.write_text(json.dumps(data, indent=2), encoding="utf-8")
    except Exception:
        pass

def pick_installed_gtk_theme(mode):
    if mode == "light":
        candidates = ["Orchis-Red-Light", "Orchis-Light", "Arc", "Greybird", "Adwaita"]
    else:
        candidates = ["Orchis-Red-Dark", "Orchis-Dark", "Arc-Dark", "Adwaita-dark"]
    for c in candidates:
        if Path(f"/usr/share/themes/{c}").exists():
            return c
    return "Adwaita" if mode == "light" else "Adwaita-dark"

def apply_theme_mode(mode):
    mode = "light" if mode == "light" else "dark"
    state = load_theme_state()
    state["mode"] = mode
    save_theme_state(state)

    gtk_theme = pick_installed_gtk_theme(mode)
    icon_theme = "Papirus-Light" if (mode == "light" and Path("/usr/share/icons/Papirus-Light").exists()) else "Papirus-Dark"
    prefer_dark = "0" if mode == "light" else "1"

    # 1. Update XFCE xsettings & xfwm4 live
    subprocess.run(f"xfconf-query -c xsettings -p /Net/ThemeName -s '{gtk_theme}' 2>/dev/null || true", shell=True)
    subprocess.run(f"xfconf-query -c xfwm4 -p /general/theme -s '{gtk_theme}' 2>/dev/null || true", shell=True)
    subprocess.run(f"xfconf-query -c xsettings -p /Net/IconThemeName -s '{icon_theme}' 2>/dev/null || true", shell=True)

    # 2. Update GTK3 settings.ini
    try:
        GTK_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
        GTK_SETTINGS.write_text(f"""[Settings]
gtk-theme-name={gtk_theme}
gtk-icon-theme-name={icon_theme}
gtk-font-name=Fira Sans 10
gtk-cursor-theme-name=Adwaita
gtk-application-prefer-dark-theme={prefer_dark}
""", encoding="utf-8")
    except Exception:
        pass

    # 3. Update Polybar colors for Light vs Dark mode
    if POLYBAR_CONF.exists():
        text = POLYBAR_CONF.read_text(encoding="utf-8")
        if mode == "light":
            text = re.sub(r"(^\s*background\s*=\s*).*", r"\g<1>#f2f6f8fa", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*background-alt\s*=\s*).*", r"\g<1>#dce1e4e8", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*foreground\s*=\s*).*", r"\g<1>#1f2328", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*secondary\s*=\s*).*", r"\g<1>#57606a", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*disabled\s*=\s*).*", r"\g<1>#8c959f", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*label-active-foreground\s*=\s*).*", r"\g<1>#1f2328", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*label-occupied-foreground\s*=\s*).*", r"\g<1>#24292f", text, flags=re.MULTILINE)
        else:
            text = re.sub(r"(^\s*background\s*=\s*).*", r"\g<1>#ee0d1117", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*background-alt\s*=\s*).*", r"\g<1>#2821262d", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*foreground\s*=\s*).*", r"\g<1>#e6edf3", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*secondary\s*=\s*).*", r"\g<1>#8b949e", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*disabled\s*=\s*).*", r"\g<1>#484f58", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*label-active-foreground\s*=\s*).*", r"\g<1>#ffffff", text, flags=re.MULTILINE)
            text = re.sub(r"(^\s*label-occupied-foreground\s*=\s*).*", r"\g<1>#c9d1d9", text, flags=re.MULTILINE)
        POLYBAR_CONF.write_text(text, encoding="utf-8")
        subprocess.Popen("bash ~/.config/polybar/launch.sh >/dev/null 2>&1 &", shell=True)

    # 4. Update Rofi Light vs Dark colors
    if ROFI_CONF.exists():
        text = ROFI_CONF.read_text(encoding="utf-8")
        if mode == "light":
            text = re.sub(r"(bg:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#F6F8FAf2;", text)
            text = re.sub(r"(bg-alt:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#EAEEF2;", text)
            text = re.sub(r"(fg:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#1F2328;", text)
            text = re.sub(r"(muted:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#57606A;", text)
        else:
            text = re.sub(r"(bg:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#0D1117ee;", text)
            text = re.sub(r"(bg-alt:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#161B22;", text)
            text = re.sub(r"(fg:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#E6EDF3;", text)
            text = re.sub(r"(muted:\s*)#[0-9A-Fa-f]{6,8};", r"\g<1>#8B949E;", text)
        ROFI_CONF.write_text(text, encoding="utf-8")

    # 5. Update XFCE4 Terminal Light vs Dark colors
    if TERMINAL_RC.exists():
        text = TERMINAL_RC.read_text(encoding="utf-8")
        if mode == "light":
            text = re.sub(r"ColorForeground=.*", "ColorForeground=#1F2328", text)
            text = re.sub(r"ColorBackground=.*", "ColorBackground=#F6F8FA", text)
        else:
            text = re.sub(r"ColorForeground=.*", "ColorForeground=#E5E9F0", text)
            text = re.sub(r"ColorBackground=.*", "ColorBackground=#0D1117", text)
        TERMINAL_RC.write_text(text, encoding="utf-8")

def apply_accent_color(hex_color):
    hex_color = hex_color.strip().upper()
    if not re.match(r"^#[0-9A-F]{6}$", hex_color):
        return

    state = load_theme_state()
    state["accent"] = hex_color
    save_theme_state(state)

    if POLYBAR_CONF.exists():
        text = POLYBAR_CONF.read_text(encoding="utf-8")
        text = re.sub(r"(^\s*primary\s*=\s*)#[0-9A-Fa-f]{6}", rf"\g<1>{hex_color}", text, flags=re.MULTILINE)
        POLYBAR_CONF.write_text(text, encoding="utf-8")
        subprocess.Popen("bash ~/.config/polybar/launch.sh >/dev/null 2>&1 &", shell=True)

    if ROFI_CONF.exists():
        text = ROFI_CONF.read_text(encoding="utf-8")
        text = re.sub(r"(rosso:\s*)#[0-9A-Fa-f]{6};", rf"\g<1>{hex_color};", text)
        text = re.sub(r"(accent:\s*)#[0-9A-Fa-f]{6};", rf"\g<1>{hex_color};", text)
        ROFI_CONF.write_text(text, encoding="utf-8")

    if TERMINAL_RC.exists():
        text = TERMINAL_RC.read_text(encoding="utf-8")
        text = re.sub(r"ColorCursor=.*", f"ColorCursor={hex_color}", text)
        text = re.sub(r"TabActivityColor=.*", f"TabActivityColor={hex_color}", text)
        TERMINAL_RC.write_text(text, encoding="utf-8")

    try:
        GTK_CSS.parent.mkdir(parents=True, exist_ok=True)
        GTK_CSS.write_text(f"""/* TaaOS Custom Accent Override */
@define-color theme_selected_bg_color {hex_color};
@define-color accent_bg_color {hex_color};
@define-color accent_color {hex_color};
selection {{
    background-color: {hex_color};
    color: #FFFFFF;
}}
progressbar progress, scale highlight {{
    background-color: {hex_color};
    border-color: {hex_color};
}}
""", encoding="utf-8")
    except Exception:
        pass

def apply_picom_profile(profile_key):
    state = load_theme_state()
    state["picom"] = profile_key
    save_theme_state(state)

    if profile_key == "performance":
        # Stop picom AND enable XFWM4 native double-buffered compositor (zero trails & zero lag!)
        subprocess.run("killall -q picom 2>/dev/null || true", shell=True)
        subprocess.run("xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null || true", shell=True)
        AUTOSTART_PICOM.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_PICOM.write_text("""[Desktop Entry]
Type=Application
Exec=true
Hidden=true
NoDisplay=true
X-GNOME-Autostart-enabled=false
Name=Picom
Comment=TaaOS Compositor Disabled (XFWM4 Native Double-Buffer Active)
""", encoding="utf-8")
        return

    if profile_key not in PICOM_PROFILES:
        return

    # Disable XFWM4 internal compositor so Picom can take over cleanly
    subprocess.run("xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null || true", shell=True)

    PICOM_CONF.parent.mkdir(parents=True, exist_ok=True)
    PICOM_CONF.write_text(PICOM_PROFILES[profile_key], encoding="utf-8")

    AUTOSTART_PICOM.parent.mkdir(parents=True, exist_ok=True)
    AUTOSTART_PICOM.write_text(f"""[Desktop Entry]
Type=Application
Exec=picom --config {PICOM_CONF} -b
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Picom
Comment=TaaOS Compositor ({profile_key})
""", encoding="utf-8")

    subprocess.run("killall -q picom 2>/dev/null || true", shell=True)
    subprocess.Popen(f"picom --config {PICOM_CONF} -b", shell=True, start_new_session=True)

def apply_polybar_style(style_key):
    if not POLYBAR_CONF.exists():
        return
    text = POLYBAR_CONF.read_text(encoding="utf-8")
    if style_key == "floating":
        text = re.sub(r"width\s*=\s*.*", "width = 98%", text)
        text = re.sub(r"offset-x\s*=\s*.*", "offset-x = 1%", text)
        text = re.sub(r"offset-y\s*=\s*.*", "offset-y = 6px", text)
        text = re.sub(r"radius\s*=\s*.*", "radius = 10", text)
        if "offset-x" not in text:
            text = text.replace("[bar/taaos]\n", "[bar/taaos]\noffset-x = 1%\noffset-y = 6px\n")
    else:
        text = re.sub(r"width\s*=\s*.*", "width = 100%", text)
        text = re.sub(r"offset-x\s*=\s*.*\n?", "", text)
        text = re.sub(r"offset-y\s*=\s*.*\n?", "", text)
        text = re.sub(r"radius\s*=\s*.*", "radius = 0", text)

    POLYBAR_CONF.write_text(text, encoding="utf-8")
    subprocess.Popen("bash ~/.config/polybar/launch.sh >/dev/null 2>&1 &", shell=True)

def apply_terminal_opacity(level):
    TERMINAL_RC.parent.mkdir(parents=True, exist_ok=True)
    if not TERMINAL_RC.exists():
        return
    text = TERMINAL_RC.read_text(encoding="utf-8")
    if level == "opaque":
        text = re.sub(r"BackgroundMode=.*", "BackgroundMode=TERMINAL_BACKGROUND_SOLID", text)
        text = re.sub(r"BackgroundDarkness=.*", "BackgroundDarkness=1.000000", text)
    elif level == "translucent":
        text = re.sub(r"BackgroundMode=.*", "BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT", text)
        text = re.sub(r"BackgroundDarkness=.*", "BackgroundDarkness=0.950000", text)
    elif level == "glass":
        text = re.sub(r"BackgroundMode=.*", "BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT", text)
        text = re.sub(r"BackgroundDarkness=.*", "BackgroundDarkness=0.850000", text)
    TERMINAL_RC.write_text(text, encoding="utf-8")

def run_gui():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk

    state = load_theme_state()
    current_accent = state.get("accent", "#D40000")

    win = Gtk.Window(title=tr("TaaOS Görünüm & Renk Stüdyosu", "TaaOS Appearance & Color Studio"))
    win.set_default_size(600, 620)
    win.set_position(Gtk.WindowPosition.CENTER)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    vbox.set_margin_top(14)
    vbox.set_margin_bottom(14)
    vbox.set_margin_start(16)
    vbox.set_margin_end(16)
    win.add(vbox)

    hdr = Gtk.Label()
    def update_header_color(hex_c):
        hdr.set_markup(
            f"<b><span size='large' foreground='{hex_c}'>{tr('TaaOS Görünüm & Renk Paleti Stüdyosu', 'TaaOS Appearance & Color Palette Studio')}</span></b>\n"
            f"<span size='small'>{tr('Aydınlık/Karanlık modu, renk paletini, pencere akıcılığını ve üst barı özelleştirin.', 'Customize Light/Dark mode, color palettes, window fluidity, and top bar layout.')}</span>"
        )
    update_header_color(current_accent)
    hdr.set_xalign(0)
    vbox.pack_start(hdr, False, False, 0)

    # 1. Dark / Light Mode Section
    frame_mode = Gtk.Frame(label=tr(" 1. Tema Modu (Karanlık / Aydınlık) ", " 1. Theme Mode (Dark / Light) "))
    box_mode = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    box_mode.set_margin_top(8)
    box_mode.set_margin_bottom(8)
    box_mode.set_margin_start(10)
    box_mode.set_margin_end(10)
    frame_mode.add(box_mode)

    btn_dark = Gtk.Button(label=tr("🌙 Karanlık Mod (Dark Mode)", "🌙 Dark Mode"))
    btn_dark.connect("clicked", lambda _: apply_theme_mode("dark"))
    btn_light = Gtk.Button(label=tr("☀️ Aydınlık Mod (Light Mode)", "☀️ Light Mode"))
    btn_light.connect("clicked", lambda _: apply_theme_mode("light"))

    box_mode.pack_start(btn_dark, True, True, 0)
    box_mode.pack_start(btn_light, True, True, 0)
    vbox.pack_start(frame_mode, False, False, 0)

    # 2. Color Palette Studio Section
    frame_color = Gtk.Frame(label=tr(" 2. Sistem Renk Paleti & Özel Renk Seçici ", " 2. System Color Palette & Custom Picker "))
    vbox_color = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    vbox_color.set_margin_top(8)
    vbox_color.set_margin_bottom(8)
    vbox_color.set_margin_start(10)
    vbox_color.set_margin_end(10)
    frame_color.add(vbox_color)

    grid_palettes = Gtk.FlowBox()
    grid_palettes.set_max_children_per_line(3)
    grid_palettes.set_selection_mode(Gtk.SelectionMode.NONE)
    grid_palettes.set_row_spacing(6)
    grid_palettes.set_column_spacing(6)

    def on_pick_palette(hex_val):
        apply_accent_color(hex_val)
        update_header_color(hex_val)
        rgba = Gdk.RGBA()
        if rgba.parse(hex_val):
            color_btn.set_rgba(rgba)

    for key, pal in COLOR_PALETTES.items():
        b = Gtk.Button(label=pal["name"])
        b.connect("clicked", lambda _, h=pal["hex"]: on_pick_palette(h))
        grid_palettes.add(b)

    vbox_color.pack_start(grid_palettes, False, False, 0)

    hbox_custom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    lbl_custom = Gtk.Label(label=tr("🎨 Kendi Özel Renginizi Seçin:", "🎨 Pick Your Own Custom Color:"))
    color_btn = Gtk.ColorButton()
    init_rgba = Gdk.RGBA()
    if init_rgba.parse(current_accent):
        color_btn.set_rgba(init_rgba)

    def on_custom_color_set(btn):
        rgba = btn.get_rgba()
        hex_val = "#{:02X}{:02X}{:02X}".format(
            int(rgba.red * 255),
            int(rgba.green * 255),
            int(rgba.blue * 255)
        )
        apply_accent_color(hex_val)
        update_header_color(hex_val)

    color_btn.connect("color-set", on_custom_color_set)
    btn_apply_custom = Gtk.Button(label=tr("Seçili Rengi Uygula", "Apply Custom Color"))
    btn_apply_custom.connect("clicked", lambda _: on_custom_color_set(color_btn))

    hbox_custom.pack_start(lbl_custom, False, False, 0)
    hbox_custom.pack_start(color_btn, False, False, 0)
    hbox_custom.pack_start(btn_apply_custom, False, False, 0)
    vbox_color.pack_start(hbox_custom, False, False, 0)
    vbox.pack_start(frame_color, False, False, 0)

    # 3. Compositor Section
    frame1 = Gtk.Frame(label=tr(" 3. Pencere Efektleri & Akıcılık ", " 3. Window Effects & Fluidity "))
    box1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box1.set_margin_top(8)
    box1.set_margin_bottom(8)
    box1.set_margin_start(10)
    box1.set_margin_end(10)
    frame1.add(box1)

    btn_perf = Gtk.Button(label=tr("⚡ Performans Modu (XFWM4 Yerel Çift-Tampon — Sıfır İz & 60 FPS)", "⚡ Performance Mode (XFWM4 Native Double-Buffer — Zero Trail & 60 FPS)"))
    btn_perf.connect("clicked", lambda _: apply_picom_profile("performance"))
    btn_bal = Gtk.Button(label=tr("✨ Dengeli TaaOS Modu (Yumuşak Gölgeler & Akıcı Geçişler)", "✨ Balanced TaaOS Mode (Soft Shadows & Smooth Fades)"))
    btn_bal.connect("clicked", lambda _: apply_picom_profile("balanced"))
    btn_ult = Gtk.Button(label=tr("💎 Ultra GPU Modu (Yuvarlatılmış Köşeler, GLX & Derin Gölge)", "💎 Ultra GPU Mode (Rounded Corners, GLX & Deep Shadows)"))
    btn_ult.connect("clicked", lambda _: apply_picom_profile("ultra"))

    box1.pack_start(btn_perf, False, False, 0)
    box1.pack_start(btn_bal, False, False, 0)
    box1.pack_start(btn_ult, False, False, 0)
    vbox.pack_start(frame1, False, False, 0)

    # 4. Polybar Style Section
    frame2 = Gtk.Frame(label=tr(" 4. Üst Panel (Polybar) Tasarımı ", " 4. Top Bar (Polybar) Layout "))
    box2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    box2.set_margin_top(8)
    box2.set_margin_bottom(8)
    box2.set_margin_start(10)
    box2.set_margin_end(10)
    frame2.add(box2)

    btn_full = Gtk.Button(label=tr("Tam Genişlik Bar (Klasik)", "Full-Width Bar (Classic)"))
    btn_full.connect("clicked", lambda _: apply_polybar_style("full"))
    btn_float = Gtk.Button(label=tr("Yüzen Ada Bar (Yuvarlatılmış)", "Floating Island Bar (Rounded)"))
    btn_float.connect("clicked", lambda _: apply_polybar_style("floating"))

    box2.pack_start(btn_full, True, True, 0)
    box2.pack_start(btn_float, True, True, 0)
    vbox.pack_start(frame2, False, False, 0)

    # 5. Terminal Transparency
    frame3 = Gtk.Frame(label=tr(" 5. Terminal Şeffaflık Seviyesi ", " 5. Terminal Transparency "))
    box3 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    box3.set_margin_top(8)
    box3.set_margin_bottom(8)
    box3.set_margin_start(10)
    box3.set_margin_end(10)
    frame3.add(box3)

    btn_t100 = Gtk.Button(label=tr("%100 Opak", "100% Opaque"))
    btn_t100.connect("clicked", lambda _: apply_terminal_opacity("opaque"))
    btn_t95 = Gtk.Button(label=tr("%95 Yarı Saydam", "95% Translucent"))
    btn_t95.connect("clicked", lambda _: apply_terminal_opacity("translucent"))
    btn_t85 = Gtk.Button(label=tr("%85 Cam (Glass)", "85% Glass"))
    btn_t85.connect("clicked", lambda _: apply_terminal_opacity("glass"))

    box3.pack_start(btn_t100, True, True, 0)
    box3.pack_start(btn_t95, True, True, 0)
    box3.pack_start(btn_t85, True, True, 0)
    vbox.pack_start(frame3, False, False, 0)

    # 6. Radial Wheel Settings Shortcut
    hbox_bot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    btn_wheel = Gtk.Button(label=tr("🎡 Sağ Tık Uygulama Çarkını (Wheel) Özelleştir", "🎡 Customize Right-Click Radial Wheel"))
    btn_wheel.connect("clicked", lambda _: subprocess.Popen(["/usr/local/bin/taaos-wheel", "--config"]))
    btn_close = Gtk.Button(label=tr("Kapat", "Close"))
    btn_close.connect("clicked", lambda _: Gtk.main_quit())

    hbox_bot.pack_start(btn_wheel, True, True, 0)
    hbox_bot.pack_end(btn_close, False, False, 0)
    vbox.pack_end(hbox_bot, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("light", "aydınlık"):
            apply_theme_mode("light")
            print("[TaaOS] Applied Light Mode")
        elif arg in ("dark", "karanlık"):
            apply_theme_mode("dark")
            print("[TaaOS] Applied Dark Mode")
        elif arg in ("toggle-mode", "--toggle-mode"):
            cur = load_theme_state().get("mode", "dark")
            new_m = "light" if cur == "dark" else "dark"
            apply_theme_mode(new_m)
            print(f"[TaaOS] Switched to {new_m} mode")
        elif arg in ("performance", "balanced", "ultra"):
            apply_picom_profile(arg)
            print(f"[TaaOS] Applied compositor profile: {arg}")
        elif arg in ("floating", "floating-bar"):
            apply_polybar_style("floating")
            print("[TaaOS] Applied floating Polybar layout")
        elif arg in ("full", "full-bar"):
            apply_polybar_style("full")
            print("[TaaOS] Applied full-width Polybar layout")
        elif arg in COLOR_PALETTES:
            apply_accent_color(COLOR_PALETTES[arg]["hex"])
            print(f"[TaaOS] Applied color palette: {arg}")
        elif arg.startswith("#") and len(arg) == 7:
            apply_accent_color(arg)
            print(f"[TaaOS] Applied custom color: {arg}")
        else:
            print("Usage: taaos-appearance [light|dark|toggle-mode|performance|balanced|ultra|floating|full|rosso|cyan|emerald|amber|purple|#RRGGBB]")
    else:
        run_gui()
