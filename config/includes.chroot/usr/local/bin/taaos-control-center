#!/usr/bin/env python3
# =============================================================================
# TaaOS Quick Settings Control Center (taaos-control-center)
# =============================================================================
# Windows 11-style Quick Settings flyout docked at the top-right under Polybar:
#   - Quick Toggle Tiles: Wi-Fi, Bluetooth, Window Fluidity (Picom), Color Studio
#   - Live Audio Volume Slider + Mute Toggle + Mixer (pavucontrol)
#   - Live Screen Brightness Slider (works on both Laptop Backlight & X11/VM via xrandr!)
#   - CLI helpers for Polybar: --brightness-get, --brightness-up, --brightness-down
# =============================================================================

import os
import re
import sys
import json
import signal
import subprocess
from pathlib import Path

_LOCALE = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en"
IS_TR = _LOCALE.lower().startswith("tr")

def tr(tr_text, en_text):
    return tr_text if IS_TR else en_text

HOME = Path.home()
STATE_FILE = HOME / ".config" / "taaos" / "control_state.json"
THEME_FILE = HOME / ".config" / "taaos" / "theme.json"
PID_FILE = Path(f"/tmp/taaos-control-center-{os.getuid()}.pid")

def load_state():
    try:
        if STATE_FILE.exists():
            return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {"brightness": 100}

def save_state(st):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
    except Exception:
        pass

def get_accent_hex():
    try:
        if THEME_FILE.exists():
            data = json.loads(THEME_FILE.read_text(encoding="utf-8"))
            c = data.get("accent", "#D40000").strip()
            if len(c) == 7 and c.startswith("#"):
                return c
    except Exception:
        pass
    return "#D40000"

# -----------------------------------------------------------------------------
# Hardware & X11 Helpers (Brightness, Volume, Wi-Fi, Bluetooth)
# -----------------------------------------------------------------------------
def get_brightness():
    st = load_state()
    return max(20, min(100, int(st.get("brightness", 100))))

def set_brightness(percent):
    percent = max(20, min(100, int(percent)))
    st = load_state()
    st["brightness"] = percent
    save_state(st)

    # 1. Try hardware backlight if available
    try:
        bl_dirs = list(Path("/sys/class/backlight").glob("*"))
        if bl_dirs and shutil_which("brightnessctl"):
            subprocess.run(["brightnessctl", "set", f"{percent}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 2. Apply X11 xrandr software brightness (works everywhere including VirtualBox & desktop monitors!)
    try:
        out = subprocess.check_output("xrandr --current 2>/dev/null", shell=True, text=True)
        outputs = re.findall(r"^([A-Za-z0-9_-]+)\s+connected", out, flags=re.MULTILINE)
        val = f"{percent / 100.0:.2f}"
        for disp in outputs:
            subprocess.run(["xrandr", "--output", disp, "--brightness", val], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def shutil_which(cmd):
    for p in os.environ.get("PATH", "").split(os.pathsep):
        full = Path(p) / cmd
        if full.exists() and os.access(full, os.X_OK):
            return str(full)
    return None

def get_volume():
    try:
        out = subprocess.check_output("pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null", shell=True, text=True)
        m = re.search(r"(\d+)%", out)
        if m:
            return min(100, int(m.group(1)))
    except Exception:
        pass
    return 75

def set_volume(percent):
    percent = max(0, min(100, int(percent)))
    subprocess.run(f"pactl set-sink-volume @DEFAULT_SINK@ {percent}% 2>/dev/null || true", shell=True)

def toggle_mute():
    subprocess.run("pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null || true", shell=True)

def is_wifi_enabled():
    try:
        out = subprocess.check_output("nmcli radio wifi 2>/dev/null", shell=True, text=True).strip().lower()
        return out == "enabled"
    except Exception:
        return True

def get_network_summary():
    try:
        out = subprocess.check_output("nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null", shell=True, text=True).strip()
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) >= 2 and parts[0] != "lo":
                return parts[0]
    except Exception:
        pass
    return tr("Bağlı", "Connected") if is_wifi_enabled() else tr("Kapalı", "Off")

def is_bluetooth_enabled():
    try:
        out = subprocess.check_output("rfkill list bluetooth 2>/dev/null", shell=True, text=True).lower()
        if "soft blocked: yes" in out:
            return False
        if "soft blocked: no" in out:
            return True
    except Exception:
        pass
    return False

# -----------------------------------------------------------------------------
# GTK3 Windows 11-Style Flyout Window
# -----------------------------------------------------------------------------
def run_flyout():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk

    # Toggle behavior: if already running, close existing instance and exit
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            if old_pid != os.getpid():
                os.kill(old_pid, signal.SIGTERM)
                PID_FILE.unlink(missing_ok=True)
                return
        except Exception:
            PID_FILE.unlink(missing_ok=True)

    try:
        PID_FILE.write_text(str(os.getpid()))
    except Exception:
        pass

    accent = get_accent_hex()

    # Apply dark modern styling for the flyout
    css_provider = Gtk.CssProvider()
    css = f"""
    window {{
        background-color: #0D1117;
        color: #E5E9F0;
        border: 2px solid {accent};
        border-radius: 10px;
    }}
    button {{
        background-image: none;
        background-color: #161B22;
        color: #E5E9F0;
        border: 1px solid #30363D;
        border-radius: 8px;
        padding: 8px 10px;
        font-weight: bold;
    }}
    button:hover {{
        background-color: {accent};
        color: #FFFFFF;
        border-color: {accent};
    }}
    button.active-tile {{
        background-color: {accent};
        color: #FFFFFF;
        border-color: {accent};
    }}
    scale highlight {{
        background-color: {accent};
        border-color: {accent};
    }}
    scale slider {{
        background-color: #FFFFFF;
        border: 2px solid {accent};
        border-radius: 50%;
        min-width: 16px;
        min-height: 16px;
    }}
    """
    css_provider.load_from_data(css.encode("utf-8"))
    screen = Gdk.Screen.get_default()
    if screen:
        Gtk.StyleContext.add_provider_for_screen(screen, css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("TaaOS Control Center")
    win.set_decorated(False)
    win.set_resizable(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_default_size(360, 340)

    # Position at top-right right below the 34px Polybar
    sw = screen.get_width() if screen else 1920
    win.move(max(10, sw - 372), 40)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    vbox.set_margin_top(14)
    vbox.set_margin_bottom(14)
    vbox.set_margin_start(14)
    vbox.set_margin_end(14)
    win.add(vbox)

    # Header Row
    hbox_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    lbl_title = Gtk.Label()
    lbl_title.set_markup(f"<b><span size='medium' foreground='{accent}'>{tr('⚡ TaaOS Hızlı Ayarlar', '⚡ TaaOS Quick Settings')}</span></b>")
    lbl_title.set_xalign(0)
    btn_close = Gtk.Button(label="✕")
    btn_close.connect("clicked", lambda _: cleanup_and_quit())
    hbox_hdr.pack_start(lbl_title, True, True, 0)
    hbox_hdr.pack_end(btn_close, False, False, 0)
    vbox.pack_start(hbox_hdr, False, False, 0)

    # 1. Windows 11-Style 2x2 Quick Toggle Grid
    grid = Gtk.Grid()
    grid.set_row_spacing(8)
    grid.set_column_spacing(8)
    grid.set_column_homogeneous(True)

    # Tile 1: Wi-Fi / Network
    wifi_on = is_wifi_enabled()
    net_name = get_network_summary()
    btn_wifi = Gtk.Button(label=f"📶 Wi-Fi / Ağ\n{net_name}")
    if wifi_on:
        btn_wifi.get_style_context().add_class("active-tile")

    def on_wifi_click(_):
        if shutil_which("nm-connection-editor"):
            subprocess.Popen(["nm-connection-editor"], start_new_session=True)
            cleanup_and_quit()
        elif shutil_which("nmtui"):
            subprocess.Popen(["xfce4-terminal", "--title=Network Manager", "-e", "nmtui"], start_new_session=True)
            cleanup_and_quit()

    btn_wifi.connect("clicked", on_wifi_click)
    grid.attach(btn_wifi, 0, 0, 1, 1)

    # Tile 2: Bluetooth
    bt_on = is_bluetooth_enabled()
    btn_bt = Gtk.Button(label=f"🦷 Bluetooth\n{tr('Açık' if bt_on else 'Ayarlar', 'On' if bt_on else 'Settings')}")
    if bt_on:
        btn_bt.get_style_context().add_class("active-tile")

    def on_bt_click(_):
        if shutil_which("blueman-manager"):
            subprocess.Popen(["blueman-manager"], start_new_session=True)
        else:
            subprocess.Popen(["xfce4-terminal", "--title=Bluetooth", "-e", "bluetoothctl"], start_new_session=True)
        cleanup_and_quit()

    btn_bt.connect("clicked", on_bt_click)
    grid.attach(btn_bt, 1, 0, 1, 1)

    # Tile 3: Window Fluidity / Performance Toggle
    picom_running = subprocess.run("pgrep -x picom >/dev/null 2>&1", shell=True).returncode == 0
    btn_fx = Gtk.Button(label=f"✨ {tr('Efekt Modu', 'FX Mode')}\n{tr('Cam/Gölge Açık', 'Glass/FX On') if picom_running else tr('Performans (0 Lag)', 'Performance (0 Lag)')}")
    if picom_running:
        btn_fx.get_style_context().add_class("active-tile")

    def on_fx_click(btn):
        running = subprocess.run("pgrep -x picom >/dev/null 2>&1", shell=True).returncode == 0
        if running:
            subprocess.run(["/usr/local/bin/taaos-appearance", "performance"])
            btn.set_label(f"✨ {tr('Efekt Modu', 'FX Mode')}\n{tr('Performans (0 Lag)', 'Performance (0 Lag)')}")
            btn.get_style_context().remove_class("active-tile")
        else:
            subprocess.run(["/usr/local/bin/taaos-appearance", "balanced"])
            btn.set_label(f"✨ {tr('Efekt Modu', 'FX Mode')}\n{tr('Cam/Gölge Açık', 'Glass/FX On')}")
            btn.get_style_context().add_class("active-tile")

    btn_fx.connect("clicked", on_fx_click)
    grid.attach(btn_fx, 0, 1, 1, 1)

    # Tile 4: Color Palette & Appearance Studio
    btn_theme = Gtk.Button(label=f"🎨 {tr('Renk Paleti', 'Color Studio')}\n{tr('Özelleştir', 'Customize')}")
    def on_theme_click(_):
        subprocess.Popen(["/usr/local/bin/taaos-appearance"], start_new_session=True)
        cleanup_and_quit()
    btn_theme.connect("clicked", on_theme_click)
    grid.attach(btn_theme, 1, 1, 1, 1)

    vbox.pack_start(grid, False, False, 0)

    # 2. Audio Volume Slider Row
    hbox_vol = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    btn_mute = Gtk.Button(label="🔊")
    btn_mute.connect("clicked", lambda _: toggle_mute())

    adj_vol = Gtk.Adjustment(value=get_volume(), lower=0, upper=100, step_increment=5, page_increment=10)
    scale_vol = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj_vol)
    scale_vol.set_digits(0)
    scale_vol.set_value_pos(Gtk.PositionType.RIGHT)
    scale_vol.set_hexpand(True)
    scale_vol.connect("value-changed", lambda s: set_volume(s.get_value()))

    btn_mixer = Gtk.Button(label="🎚")
    btn_mixer.set_tooltip_text(tr("Ses Karıştırıcısı (pavucontrol)", "Audio Mixer (pavucontrol)"))
    def on_mixer(_):
        if shutil_which("pavucontrol"):
            subprocess.Popen(["pavucontrol"], start_new_session=True)
            cleanup_and_quit()
    btn_mixer.connect("clicked", on_mixer)

    hbox_vol.pack_start(btn_mute, False, False, 0)
    hbox_vol.pack_start(scale_vol, True, True, 0)
    hbox_vol.pack_start(btn_mixer, False, False, 0)
    vbox.pack_start(hbox_vol, False, False, 0)

    # 3. Screen Brightness Slider Row
    hbox_bri = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    lbl_bri = Gtk.Button(label="☀️")
    lbl_bri.connect("clicked", lambda _: adj_bri.set_value(100))

    adj_bri = Gtk.Adjustment(value=get_brightness(), lower=25, upper=100, step_increment=5, page_increment=10)
    scale_bri = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj_bri)
    scale_bri.set_digits(0)
    scale_bri.set_value_pos(Gtk.PositionType.RIGHT)
    scale_bri.set_hexpand(True)
    scale_bri.connect("value-changed", lambda s: set_brightness(s.get_value()))

    hbox_bri.pack_start(lbl_bri, False, False, 0)
    hbox_bri.pack_start(scale_bri, True, True, 0)
    vbox.pack_start(hbox_bri, False, False, 0)

    # 4. Bottom Action Shortcuts (TaaNOS AI, Radial Wheel Config, System Monitor)
    hbox_bot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    btn_ai = Gtk.Button(label="🤖 TaaNOS AI")
    btn_ai.connect("clicked", lambda _: (subprocess.Popen(["xfce4-terminal", "--title=TaaNOS AI", "-e", "taanos"], start_new_session=True), cleanup_and_quit()))
    btn_wheel = Gtk.Button(label=tr("🎡 Çark", "🎡 Wheel"))
    btn_wheel.connect("clicked", lambda _: (subprocess.Popen(["/usr/local/bin/taaos-wheel", "--config"], start_new_session=True), cleanup_and_quit()))
    btn_mon = Gtk.Button(label="📊 btop")
    btn_mon.connect("clicked", lambda _: (subprocess.Popen(["xfce4-terminal", "--title=System Monitor", "-e", "btop"], start_new_session=True), cleanup_and_quit()))

    hbox_bot.pack_start(btn_ai, True, True, 0)
    hbox_bot.pack_start(btn_wheel, True, True, 0)
    hbox_bot.pack_start(btn_mon, True, True, 0)
    vbox.pack_end(hbox_bot, False, False, 0)

    def cleanup_and_quit(*_):
        PID_FILE.unlink(missing_ok=True)
        Gtk.main_quit()

    win.connect("destroy", cleanup_and_quit)
    win.connect("key-press-event", lambda w, e: cleanup_and_quit() if e.keyval == Gdk.KEY_Escape else False)
    win.show_all()
    win.present()
    Gtk.main()

if __name__ == "__main__":
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "--brightness-get":
            print(f"{get_brightness()}%")
        elif cmd == "--brightness-up":
            b = min(100, get_brightness() + 5)
            set_brightness(b)
            print(f"{b}%")
        elif cmd == "--brightness-down":
            b = max(25, get_brightness() - 5)
            set_brightness(b)
            print(f"{b}%")
        else:
            run_flyout()
    else:
        run_flyout()
