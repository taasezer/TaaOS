#!/usr/bin/env python3
# =============================================================================
# TaaOS Modern Control Center Flyout (taaos-control-center)
# =============================================================================
# Sleek, headerless Bento-Grid Control Center docked at the top-right:
#   - 2x2 Pill Toggles: Wi-Fi, Bluetooth, Dark/Light Mode, Appearance Studio
#   - Full-Width Card Sliders: Audio Volume + Mixer & Screen Brightness + Auto-Fit
#   - Bottom Pill Bar: TaaNOS AI, Radial Wheel, System Monitor, Power
#   - Uses FontAwesome vector glyphs (zero missing emoji boxes!)
#   - CLI helpers for Polybar: --brightness-get, --brightness-up, --brightness-down
# =============================================================================

import os
import re
import sys
import json
import signal
import subprocess
from pathlib import Path

_LOCALE = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en"
IS_TR = _LOCALE.lower().startswith("tr")

def tr(tr_text, en_text):
    return tr_text if IS_TR else en_text

HOME = Path.home()
STATE_FILE = HOME / ".config" / "taaos" / "control_state.json"
THEME_FILE = HOME / ".config" / "taaos" / "theme.json"
PID_FILE = Path(f"/tmp/taaos-control-center-{os.getuid()}.pid")

def load_state():
    try:
        if STATE_FILE.exists():
            return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {"brightness": 100}

def save_state(st):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(st, indent=2), encoding="utf-8")
    except Exception:
        pass

def get_theme_info():
    accent = "#D40000"
    mode = "dark"
    try:
        if THEME_FILE.exists():
            data = json.loads(THEME_FILE.read_text(encoding="utf-8"))
            c = data.get("accent", "#D40000").strip()
            if len(c) == 7 and c.startswith("#"):
                accent = c
            m = data.get("mode", "dark").strip().lower()
            if m in ("light", "dark"):
                mode = m
    except Exception:
        pass
    return accent, mode

# -----------------------------------------------------------------------------
# Hardware & X11 Helpers (Brightness, Volume, Wi-Fi, Bluetooth)
# -----------------------------------------------------------------------------
def shutil_which(cmd):
    for p in os.environ.get("PATH", "").split(os.pathsep):
        full = Path(p) / cmd
        if full.exists() and os.access(full, os.X_OK):
            return str(full)
    return None

def get_brightness():
    st = load_state()
    return max(25, min(100, int(st.get("brightness", 100))))

def set_brightness(percent):
    percent = max(25, min(100, int(percent)))
    st = load_state()
    st["brightness"] = percent
    save_state(st)

    try:
        bl_dirs = list(Path("/sys/class/backlight").glob("*"))
        if bl_dirs and shutil_which("brightnessctl"):
            subprocess.run(["brightnessctl", "set", f"{percent}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    try:
        out = subprocess.check_output("LC_ALL=C xrandr --current 2>/dev/null", shell=True, text=True)
        outputs = re.findall(r"^([A-Za-z0-9_-]+)\s+connected", out, flags=re.MULTILINE)
        val = f"{percent / 100.0:.2f}"
        for disp in outputs:
            subprocess.run(["xrandr", "--output", disp, "--brightness", val], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def get_volume():
    try:
        out = subprocess.check_output("LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null", shell=True, text=True)
        m = re.search(r"(\d+)%", out)
        if m:
            return min(100, int(m.group(1)))
    except Exception:
        pass
    return 75

def set_volume(percent):
    percent = max(0, min(100, int(percent)))
    subprocess.run(f"pactl set-sink-volume @DEFAULT_SINK@ {percent}% 2>/dev/null || true", shell=True)

def toggle_mute():
    subprocess.run("pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null || true", shell=True)

def is_wifi_enabled():
    try:
        out = subprocess.check_output("LC_ALL=C nmcli radio wifi 2>/dev/null", shell=True, text=True).strip().lower()
        return out == "enabled"
    except Exception:
        return True

def get_network_summary():
    try:
        out = subprocess.check_output("LC_ALL=C nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null", shell=True, text=True).strip()
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) >= 2 and parts[0] != "lo":
                return parts[0][:14]
    except Exception:
        pass
    return tr("Bağlı", "Connected") if is_wifi_enabled() else tr("Kapalı", "Off")

def is_bluetooth_enabled():
    try:
        out = subprocess.check_output("LC_ALL=C rfkill list bluetooth 2>/dev/null", shell=True, text=True).lower()
        if "soft blocked: yes" in out:
            return False
        if "soft blocked: no" in out:
            return True
    except Exception:
        pass
    return False

# -----------------------------------------------------------------------------
# Modern Headerless Bento Control Center Flyout
# -----------------------------------------------------------------------------
def run_flyout():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk

    # Toggle behavior: if already open, close it
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            if old_pid != os.getpid():
                os.kill(old_pid, signal.SIGTERM)
                PID_FILE.unlink(missing_ok=True)
                return
        except Exception:
            PID_FILE.unlink(missing_ok=True)

    try:
        PID_FILE.write_text(str(os.getpid()))
    except Exception:
        pass

    accent, mode = get_theme_info()
    is_light = (mode == "light")

    bg_main = "#F6F8FA" if is_light else "#0D1117"
    bg_card = "#FFFFFF" if is_light else "#161B22"
    bg_hover = "#EAEEF2" if is_light else "#21262D"
    fg_main = "#1F2328" if is_light else "#E6EDF3"
    border_col = "#D0D7DE" if is_light else "#30363D"

    css_provider = Gtk.CssProvider()
    css = f"""
    window, .background {{
        background-color: {bg_main};
        color: {fg_main};
        border: 1px solid {accent};
        border-radius: 0px;
        box-shadow: none;
        margin: 0px;
        font-family: "Fira Sans", "FontAwesome", sans-serif;
    }}
    decoration {{
        border-radius: 0px;
        box-shadow: none;
        border: none;
        margin: 0px;
    }}
    .slider-card {{
        background-color: {bg_card};
        border: 1px solid {border_col};
        border-radius: 10px;
        padding: 8px 12px;
    }}
    button.bento-tile {{
        background-image: none;
        background-color: {bg_card};
        color: {fg_main};
        border: 1px solid {border_col};
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: bold;
    }}
    button.bento-tile:hover {{
        background-color: {bg_hover};
        border-color: {accent};
    }}
    button.active-tile {{
        background-image: none;
        background-color: {accent};
        color: #FFFFFF;
        border: 1px solid {accent};
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: bold;
    }}
    button.active-tile:hover {{
        opacity: 0.92;
    }}
    button.pill-btn {{
        background-image: none;
        background-color: {bg_card};
        color: {fg_main};
        border: 1px solid {border_col};
        border-radius: 8px;
        padding: 7px 10px;
        font-weight: 600;
    }}
    button.pill-btn:hover {{
        background-color: {accent};
        color: #FFFFFF;
        border-color: {accent};
    }}
    button.icon-btn {{
        background-image: none;
        background-color: transparent;
        color: {fg_main};
        border: none;
        border-radius: 6px;
        padding: 4px 8px;
    }}
    button.icon-btn:hover {{
        background-color: {bg_hover};
    }}
    scale {{
        min-width: 215px;
    }}
    scale contents {{
        min-width: 215px;
    }}
    scale trough {{
        background-color: {border_col};
        border-radius: 6px;
        min-width: 215px;
        min-height: 8px;
    }}
    scale highlight {{
        background-color: {accent};
        border-color: {accent};
        border-radius: 6px;
        min-height: 8px;
    }}
    scale slider {{
        background-color: #FFFFFF;
        border: 2px solid {accent};
        border-radius: 50%;
        min-width: 16px;
        min-height: 16px;
    }}
    """
    css_provider.load_from_data(css.encode("utf-8"))
    screen = Gdk.Screen.get_default()
    if screen:
        Gtk.StyleContext.add_provider_for_screen(screen, css_provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("TaaOS Control Center")
    win.set_decorated(False)
    win.set_resizable(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_default_size(364, 308)

    sw = screen.get_width() if screen else 1920
    win.move(max(10, sw - 374), 38)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    vbox.set_margin_top(14)
    vbox.set_margin_bottom(14)
    vbox.set_margin_start(14)
    vbox.set_margin_end(14)
    win.add(vbox)

    def cleanup_and_quit(*_):
        PID_FILE.unlink(missing_ok=True)
        Gtk.main_quit()

    # 1. Bento 2x2 Quick Toggles (Headerless, FontAwesome Vector Glyphs)
    grid = Gtk.Grid()
    grid.set_row_spacing(8)
    grid.set_column_spacing(8)
    grid.set_column_homogeneous(True)

    # Tile 1: Wi-Fi / Network (\uf1eb = fa-wifi)
    wifi_on = is_wifi_enabled()
    net_name = get_network_summary()
    btn_wifi = Gtk.Button(label=f"\uf1eb   Wi-Fi / {tr('Ağ', 'Net')}\n{net_name}")
    btn_wifi.get_style_context().add_class("active-tile" if wifi_on else "bento-tile")

    def on_wifi_click(_):
        if shutil_which("nm-connection-editor"):
            subprocess.Popen(["nm-connection-editor"], start_new_session=True)
            cleanup_and_quit()
        elif shutil_which("nmtui"):
            subprocess.Popen(["xfce4-terminal", "--title=Network", "-e", "nmtui"], start_new_session=True)
            cleanup_and_quit()

    btn_wifi.connect("clicked", on_wifi_click)
    grid.attach(btn_wifi, 0, 0, 1, 1)

    # Tile 2: Bluetooth (\uf294 = fa-bluetooth-b)
    bt_on = is_bluetooth_enabled()
    btn_bt = Gtk.Button(label=f"\uf294   Bluetooth\n{tr('Açık' if bt_on else 'Ayarlar', 'On' if bt_on else 'Settings')}")
    btn_bt.get_style_context().add_class("active-tile" if bt_on else "bento-tile")

    def on_bt_click(_):
        if shutil_which("blueman-manager"):
            subprocess.Popen(["blueman-manager"], start_new_session=True)
        else:
            subprocess.Popen(["xfce4-terminal", "--title=Bluetooth", "-e", "bluetoothctl"], start_new_session=True)
        cleanup_and_quit()

    btn_bt.connect("clicked", on_bt_click)
    grid.attach(btn_bt, 1, 0, 1, 1)

    # Tile 3: Dark / Light Mode Toggle (\uf185 = fa-sun-o, \uf186 = fa-moon-o)
    mode_label = (
        tr("\uf185   Aydınlık Mod\nKaranlığa Geç", "\uf185   Light Mode\nSwitch to Dark")
        if is_light
        else tr("\uf186   Karanlık Mod\nAydınlığa Geç", "\uf186   Dark Mode\nSwitch to Light")
    )
    btn_mode = Gtk.Button(label=mode_label)
    btn_mode.get_style_context().add_class("active-tile" if not is_light else "bento-tile")

    def on_mode_click(_):
        new_mode = "dark" if is_light else "light"
        subprocess.Popen(["/usr/local/bin/taaos-appearance", new_mode], start_new_session=True)
        cleanup_and_quit()

    btn_mode.connect("clicked", on_mode_click)
    grid.attach(btn_mode, 0, 1, 1, 1)

    # Tile 4: Color Studio & Appearance (\uf1fc = fa-paint-brush)
    btn_theme = Gtk.Button(label=f"\uf1fc   {tr('Görünüm Stüdyosu', 'Appearance')}\n{tr('Renk & Efektler', 'Color & Effects')}")
    btn_theme.get_style_context().add_class("bento-tile")
    btn_theme.connect("clicked", lambda _: (subprocess.Popen(["/usr/local/bin/taaos-appearance"], start_new_session=True), cleanup_and_quit()))
    grid.attach(btn_theme, 1, 1, 1, 1)

    vbox.pack_start(grid, False, False, 0)

    # 2. Card-Wrapped Audio Slider (\uf028 = fa-volume-up, \uf1de = fa-sliders)
    card_vol = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    card_vol.get_style_context().add_class("slider-card")

    btn_mute = Gtk.Button(label="\uf028")
    btn_mute.get_style_context().add_class("icon-btn")
    btn_mute.connect("clicked", lambda _: toggle_mute())

    adj_vol = Gtk.Adjustment(value=get_volume(), lower=0, upper=100, step_increment=5, page_increment=10)
    scale_vol = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj_vol)
    scale_vol.set_digits(0)
    scale_vol.set_value_pos(Gtk.PositionType.RIGHT)
    scale_vol.set_hexpand(True)
    scale_vol.set_halign(Gtk.Align.FILL)
    scale_vol.set_size_request(215, 28)
    scale_vol.connect("value-changed", lambda s: set_volume(s.get_value()))

    btn_mixer = Gtk.Button(label="\uf1de")
    btn_mixer.get_style_context().add_class("icon-btn")
    btn_mixer.set_tooltip_text(tr("Ses Karıştırıcısı", "Audio Mixer"))
    btn_mixer.connect("clicked", lambda _: (subprocess.Popen(["pavucontrol"], start_new_session=True), cleanup_and_quit()) if shutil_which("pavucontrol") else None)

    card_vol.pack_start(btn_mute, False, False, 0)
    card_vol.pack_start(scale_vol, True, True, 0)
    card_vol.pack_start(btn_mixer, False, False, 0)
    vbox.pack_start(card_vol, False, False, 0)

    # 3. Card-Wrapped Brightness Slider + Display Auto-Fit (\uf185 = fa-sun-o, \uf108 = fa-desktop)
    card_bri = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    card_bri.get_style_context().add_class("slider-card")

    btn_bri = Gtk.Button(label="\uf185")
    btn_bri.get_style_context().add_class("icon-btn")
    btn_bri.connect("clicked", lambda _: adj_bri.set_value(100))

    adj_bri = Gtk.Adjustment(value=get_brightness(), lower=25, upper=100, step_increment=5, page_increment=10)
    scale_bri = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj_bri)
    scale_bri.set_digits(0)
    scale_bri.set_value_pos(Gtk.PositionType.RIGHT)
    scale_bri.set_hexpand(True)
    scale_bri.set_halign(Gtk.Align.FILL)
    scale_bri.set_size_request(215, 28)
    scale_bri.connect("value-changed", lambda s: set_brightness(s.get_value()))

    btn_disp = Gtk.Button(label="\uf108")
    btn_disp.get_style_context().add_class("icon-btn")
    btn_disp.set_tooltip_text(tr("Ekran Boyutunu Otomatik Sığdır", "Auto-Fit Screen Resolution"))
    btn_disp.connect("clicked", lambda _: (subprocess.Popen(["/usr/local/bin/taaos-display-fix"], start_new_session=True), cleanup_and_quit()))

    card_bri.pack_start(btn_bri, False, False, 0)
    card_bri.pack_start(scale_bri, True, True, 0)
    card_bri.pack_start(btn_disp, False, False, 0)
    vbox.pack_start(card_bri, False, False, 0)

    # 4. Bottom Action Pill Bar (\uf120 = fa-terminal, \uf013 = fa-cog, \uf080 = fa-bar-chart, \uf011 = fa-power-off)
    hbox_bot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

    btn_ai = Gtk.Button(label="\uf120  TaaNOS")
    btn_ai.get_style_context().add_class("pill-btn")
    btn_ai.connect("clicked", lambda _: (subprocess.Popen(["xfce4-terminal", "--title=TaaNOS AI", "-e", "taanos"], start_new_session=True), cleanup_and_quit()))

    btn_wheel = Gtk.Button(label=tr("\uf013  Çark", "\uf013  Wheel"))
    btn_wheel.get_style_context().add_class("pill-btn")
    btn_wheel.connect("clicked", lambda _: (subprocess.Popen(["/usr/local/bin/taaos-wheel", "--config"], start_new_session=True), cleanup_and_quit()))

    btn_mon = Gtk.Button(label="\uf080  btop")
    btn_mon.get_style_context().add_class("pill-btn")
    btn_mon.connect("clicked", lambda _: (subprocess.Popen(["xfce4-terminal", "--title=System Monitor", "-e", "btop"], start_new_session=True), cleanup_and_quit()))

    btn_pwr = Gtk.Button(label="\uf011")
    btn_pwr.get_style_context().add_class("pill-btn")
    btn_pwr.connect("clicked", lambda _: (subprocess.Popen(["xfce4-session-logout"], start_new_session=True), cleanup_and_quit()))

    hbox_bot.pack_start(btn_ai, True, True, 0)
    hbox_bot.pack_start(btn_wheel, True, True, 0)
    hbox_bot.pack_start(btn_mon, True, True, 0)
    hbox_bot.pack_end(btn_pwr, False, False, 0)
    vbox.pack_end(hbox_bot, False, False, 0)

    win.connect("destroy", cleanup_and_quit)
    win.connect("key-press-event", lambda w, e: cleanup_and_quit() if e.keyval == Gdk.KEY_Escape else False)
    win.show_all()
    win.present()
    Gtk.main()

if __name__ == "__main__":
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "--brightness-get":
            print(f"{get_brightness()}%")
        elif cmd == "--brightness-up":
            b = min(100, get_brightness() + 5)
            set_brightness(b)
            print(f"{b}%")
        elif cmd == "--brightness-down":
            b = max(25, get_brightness() - 5)
            set_brightness(b)
            print(f"{b}%")
        else:
            run_flyout()
    else:
        run_flyout()
