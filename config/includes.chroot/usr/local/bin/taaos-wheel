#!/usr/bin/env python3
# =============================================================================
# TaaOS Radial Wheel (Çark) — Right-Click Hold Application Launcher
# =============================================================================
# Opens a CachyOS Dark + Rosso Corsa Red circular pie menu right at the mouse
# cursor when holding Down Right-Click (>= 260ms), or when invoked directly.
# Supports both:
#   1. Hold Right-Click -> Drag to slice -> Release Right-Click (Fast Gesture)
#   2. Hold Right-Click -> Release in center -> Left-Click slice (Browse Mode)
#   3. 'taaos-wheel --config' GUI to add, edit, or remove favorite apps.
# =============================================================================

import os
import sys
import math
import json
import time
import signal
import ctypes
import subprocess
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Pango
import cairo

# -----------------------------------------------------------------------------
# Locale & Language Detection (TR if system locale starts with 'tr', else EN)
# -----------------------------------------------------------------------------
_LOCALE = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en"
IS_TR = _LOCALE.lower().startswith("tr")

def tr(tr_text, en_text):
    return tr_text if IS_TR else en_text

# -----------------------------------------------------------------------------
# Configuration Management (~/.config/taaos/wheel.json)
# -----------------------------------------------------------------------------
CONFIG_DIR = Path.home() / ".config" / "taaos"
CONFIG_FILE = CONFIG_DIR / "wheel.json"
PID_FILE = Path(f"/tmp/taaos-wheel-{os.getuid()}.pid")

