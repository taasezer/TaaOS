#!/bin/bash
# =============================================================================
# TaaOS Quick Help Menu
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}==============================================${NC}"
echo -e "${GREEN}  TaaOS Komutları - Hızlı Yardım Menüsü${NC}"
echo -e "${CYAN}==============================================${NC}"
echo ""
echo -e "${YELLOW}Sistem Yönetimi:${NC}"
echo -e "  ${GREEN}taaos-update${NC}      Sistemi ve Flatpak paketlerini günceller"
echo -e "  ${GREEN}taaos-clean${NC}       APT önbellek, yetim paket, eski log temizliği"
echo -e "  ${GREEN}taaos-doctor${NC}      Sistem sağlık raporu (Disk, RAM, CPU, Servisler)"
echo -e "  ${GREEN}taaos-help${NC}        Bu yardım menüsünü gösterir"
echo ""
echo -e "${YELLOW}Yapay Zeka:${NC}"
echo -e "  ${GREEN}natural \"mesaj\"${NC}   Doğal dilde komut yazdırır (Örn: natural \"sistemi güncelle\")"
echo -e "  ${GREEN}n \"mesaj\"${NC}         natural kısayolu"
echo -e "  ${GREEN}ai \"mesaj\"${NC}        natural kısayolu"
echo ""
echo -e "${YELLOW}Geliştirici Araçları:${NC}"
echo -e "  ${GREEN}bat <dosya>${NC}       Syntax highlighting'li dosya görüntüleme"
echo -e "  ${GREEN}eza${NC}              Renkli, ikonlu dosya listesi (ls yerine)"
echo -e "  ${GREEN}fzf${NC}              Fuzzy dosya arama (Ctrl+R = geçmiş arama)"
echo -e "  ${GREEN}tldr <komut>${NC}      Kısa ve pratik komut örnekleri"
echo ""
echo -e "${YELLOW}Kısayollar:${NC}"
echo -e "  ${GREEN}update${NC}            Hızlı APT güncelleme"
echo -e "  ${GREEN}ports${NC}             Açık portları listeler"
echo -e "  ${GREEN}ll${NC}                Ayrıntılı dosya listesi"
echo -e "  ${GREEN}health-check${NC}      Sistem bütünlük kontrolü"
echo ""
