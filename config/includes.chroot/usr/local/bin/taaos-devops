#!/bin/bash
# =============================================================================
# TaaOS DevOps Suite — Modular CRUD Engine
# =============================================================================
# Manage Docker, Kubernetes (kubectl, helm, k9s), Terraform, Ansible on-demand.
# Usage: taaos-devops [status|install|update|remove] [target] [--lang=tr|en]
# =============================================================================

set -e

LIB_DIR="/usr/local/lib/taaos"
if [ ! -f "${LIB_DIR}/common.sh" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "${SCRIPT_DIR}/../lib/taaos/common.sh" ]; then
        LIB_DIR="${SCRIPT_DIR}/../lib/taaos"
    fi
fi

if [ -f "${LIB_DIR}/common.sh" ]; then
    source "${LIB_DIR}/common.sh" "$@"
else
    RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'
    t() { echo "$2"; }
    log_info() { echo -e "${CYAN}[INFO]${NC} $*"; }
    log_success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
    log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
    log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
    taaos_banner() { echo -e "${RED}=== $1 ===${NC}"; }
    is_cmd_installed() { command -v "$1" >/dev/null 2>&1; }
    print_status_item() { if is_cmd_installed "$2"; then echo -e "  ${GREEN}[✓]${NC} $1 (Installed)"; else echo -e "  ${RED}[○]${NC} $1 (Not installed)"; fi; }
    confirm() { return 0; }
    taaos_apt_install() { sudo apt-get update -qq && sudo apt-get install -y "$@"; }
    taaos_apt_remove() { sudo apt-get remove -y --purge "$@" && sudo apt-get autoremove -y; }
    is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }
fi

# =============================================================================
# READ: STATUS REPORT (Bilingual & Educational)
# =============================================================================
show_status() {
    taaos_banner \
        "$(t 'TaaOS DevOps & Bulut Yığını' 'TaaOS DevOps & Cloud Suite')" \
        "$(t 'Konteyner, Kubernetes ve Altyapı Araçları' 'Containers, Kubernetes, and Infrastructure as Code')"

    echo -e "${YELLOW}1. $(t 'Konteyner Araçları' 'Container Tooling'):${NC}"
    print_status_item "Docker CLI" "docker" "docker --version" \
        "$(t 'Konteyner oluşturma, çalıştırma ve yönetme motoru' 'Build, ship, and run distributed container applications')"
    print_status_item "Docker Compose" "docker-compose" "docker-compose --version" \
        "$(t 'Çoklu konteynerli uygulamaları YAML ile orkestre etme aracı' 'Multi-container orchestration definition tool using YAML')"
    print_status_item "Lazydocker" "lazydocker" "lazydocker --version" \
        "$(t 'Docker konteynerleri ve imajları için terminal kullanıcı arayüzü (TUI)' 'Terminal UI for Docker and Docker Compose management')"
    print_status_item "ctop" "ctop" "ctop -v" \
        "$(t 'Konteyner kaynak tüketimi (CPU, RAM, Ağ) anlık izleme aracı' 'Top-like real-time metrics monitor for containers')"

    echo -e "\n${YELLOW}2. $(t 'Kubernetes Ekosistemi' 'Kubernetes Ecosystem'):${NC}"
    print_status_item "kubectl" "kubectl" "kubectl version --client -o yaml | grep gitVersion | head -1" \
        "$(t 'Resmi Kubernetes küme yönetim ve operasyon terminal istemcisi' 'Official Kubernetes cluster control CLI')"
    print_status_item "Helm" "helm" "helm version --short" \
        "$(t 'Kubernetes için paket ve sürüm yöneticisi (K8s charts)' 'The package manager for Kubernetes applications')"
    print_status_item "k9s" "k9s" "k9s version -s | head -1" \
        "$(t 'Kubernetes kümelerini izlemek ve yönetmek için klavye odaklı TUI' 'Fast, terminal-based keyboard-driven UI to interact with your clusters')"

    echo -e "\n${YELLOW}3. $(t 'Altyapı Kodlama (IaC) & Otomasyon' 'Infrastructure as Code (IaC) & Automation'):${NC}"
    print_status_item "Terraform" "terraform" "terraform --version | head -1" \
        "$(t 'Bulut altyapılarını kod olarak bildirimsel tanımlama ve dağıtma aracı' 'Declarative infrastructure as code provisioning engine')"
    print_status_item "Ansible" "ansible" "ansible --version | head -1" \
        "$(t 'Ajan gerektirmeyen SSH tabanlı sistem yapılandırma ve dağıtım otomasyonu' 'Agentless IT automation and configuration management tool')"

    echo -e "\n${YELLOW}4. $(t 'Bulut CLI Araçları' 'Cloud CLI Tools'):${NC}"
    print_status_item "AWS CLI" "aws" "aws --version" \
        "$(t 'Amazon Web Services kaynaklarını yönetmek için komut satırı arayüzü' 'Unified tool to manage your Amazon Web Services')"

    if is_wsl; then
        echo -e "\n${DIM}[$(t 'Not: WSL2 ortamında Windows Docker Desktop entegrasyonu otomatik desteklenir.' 'Note: In WSL2, Windows Docker Desktop integration is automatically supported.')]${NC}"
    fi
    echo ""
}

# =============================================================================
# CREATE: INSTALLERS
# =============================================================================
install_docker() {
    log_info "$(t 'Docker ve konteyner araçları yapılandırılıyor...' 'Configuring Docker and container tooling...')"
    if is_wsl; then
        log_info "$(t 'WSL2 tespit edildi. Docker CLI ve Docker Desktop köprüsü yapılandırılıyor...' 'WSL2 detected. Setting up Docker CLI bridge...')"
        taaos_apt_install docker.io docker-compose
        sudo usermod -aG docker "$USER" 2>/dev/null || true
        log_success "$(t 'WSL Docker CLI hazır!' 'WSL Docker CLI is ready!')"
    else
        log_info "$(t 'TaaOS bağımsız Docker Engine kuruluyor...' 'Installing TaaOS standalone Docker Engine...')"
        taaos_apt_install docker.io docker-compose
        sudo systemctl enable docker 2>/dev/null || true
        sudo systemctl start docker 2>/dev/null || true
        sudo usermod -aG docker "$USER" 2>/dev/null || true
        log_success "$(t 'Docker Engine hazır!' 'Docker Engine is ready!')"
    fi

    if ! is_cmd_installed lazydocker; then
        log_info "$(t 'Lazydocker TUI kuruluyor...' 'Installing Lazydocker TUI...')"
        curl -sL "https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh" | bash 2>/dev/null || true
        if [ -f "$HOME/.local/bin/lazydocker" ]; then
            sudo mv "$HOME/.local/bin/lazydocker" /usr/local/bin/
        fi
    fi
}

install_k8s() {
    log_info "$(t 'Kubernetes araçları kuruluyor (kubectl, helm, k9s)...' 'Installing Kubernetes tools (kubectl, helm, k9s)...')"

    if ! is_cmd_installed kubectl; then
        log_info "$(t 'kubectl indiriliyor...' 'Downloading kubectl...')"
        local kver
        kver=$(curl -L -s https://dl.k8s.io/release/stable.txt || echo "v1.31.0")
        sudo curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${kver}/bin/linux/amd64/kubectl"
        sudo chmod +x /usr/local/bin/kubectl
    fi

    if ! is_cmd_installed helm; then
        log_info "$(t 'Helm kuruluyor...' 'Installing Helm...')"
        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash 2>/dev/null || true
    fi

    if ! is_cmd_installed k9s; then
        log_info "$(t 'k9s TUI kuruluyor...' 'Installing k9s TUI...')"
        local k9s_ver="v0.32.7"
        curl -sL "https://github.com/derailed/k9s/releases/download/${k9s_ver}/k9s_Linux_amd64.tar.gz" | sudo tar -xz -C /usr/local/bin k9s 2>/dev/null || true
    fi

    log_success "$(t 'Kubernetes yığını hazır!' 'Kubernetes stack is ready!')"
}

install_iac() {
    log_info "$(t 'Altyapı araçları kuruluyor (Terraform, Ansible)...' 'Installing IaC tools (Terraform, Ansible)...')"
    taaos_apt_install ansible

    if ! is_cmd_installed terraform; then
        log_info "$(t 'OpenTofu / Terraform CLI kuruluyor...' 'Installing OpenTofu / Terraform CLI...')"
        curl -fsSL https://get.opentofu.org/install-opentofu.sh | sudo bash -s -- --install-method deb 2>/dev/null || true
        if is_cmd_installed tofu; then
            sudo ln -sf /usr/bin/tofu /usr/local/bin/terraform 2>/dev/null || true
        fi
    fi

    log_success "$(t 'IaC otomasyon araçları hazır!' 'IaC automation tools are ready!')"
}

install_cloud() {
    log_info "$(t 'AWS CLI v2 kuruluyor...' 'Installing AWS CLI v2...')"
    taaos_apt_install awscli || true
    log_success "$(t 'Bulut CLI araçları hazır!' 'Cloud CLI tools are ready!')"
}

install_all() {
    log_info "$(t 'Tüm DevOps yığını kuruluyor...' 'Installing full DevOps suite...')"
    install_docker
    install_k8s
    install_iac
    install_cloud
    log_success "$(t 'Tüm DevOps araçları başarıyla kuruldu!' 'All DevOps tools installed successfully!')"
}

# =============================================================================
# UPDATE: UPDATERS
# =============================================================================
update_target() {
    local target="$1"
    case "$target" in
        docker)
            log_info "$(t 'Docker güncelleniyor...' 'Updating Docker...')"
            taaos_apt_install --only-upgrade docker.io docker-compose 2>/dev/null || true
            log_success "$(t 'Docker güncellendi.' 'Docker updated.')"
            ;;
        k8s)
            log_info "$(t 'Kubernetes araçları güncelleniyor...' 'Updating Kubernetes tools...')"
            install_k8s
            ;;
        iac)
            log_info "$(t 'Ansible ve IaC araçları güncelleniyor...' 'Updating Ansible & IaC tools...')"
            taaos_apt_install --only-upgrade ansible 2>/dev/null || true
            ;;
        all|"")
            log_info "$(t 'Tüm DevOps araçları taranıp güncelleniyor...' 'Scanning and updating all DevOps tools...')"
            if is_cmd_installed docker; then update_target docker; fi
            if is_cmd_installed kubectl; then update_target k8s; fi
            if is_cmd_installed ansible; then update_target iac; fi
            log_success "$(t 'Tüm DevOps bileşenleri güncellendi!' 'All DevOps components updated!')"
            ;;
    esac
}

# =============================================================================
# DELETE: UNINSTALLERS
# =============================================================================
remove_target() {
    local target="$1"
    case "$target" in
        docker)
            if confirm "$(t 'Docker paketlerini kaldırmak istiyor musunuz?' 'Do you want to remove Docker packages?')"; then
                taaos_apt_remove docker.io docker-compose
                sudo rm -f /usr/local/bin/lazydocker
                log_success "$(t 'Docker kaldırıldı.' 'Docker removed.')"
            fi
            ;;
        k8s)
            if confirm "$(t 'Kubernetes araçlarını kaldırmak istiyor musunuz?' 'Do you want to remove Kubernetes tools?')"; then
                sudo rm -f /usr/local/bin/kubectl /usr/local/bin/helm /usr/local/bin/k9s
                log_success "$(t 'Kubernetes araçları kaldırıldı.' 'Kubernetes tools removed.')"
            fi
            ;;
        iac)
            if confirm "$(t 'Ansible ve Terraform araçlarını kaldırmak istiyor musunuz?' 'Do you want to remove Ansible & Terraform?')"; then
                taaos_apt_remove ansible
                sudo rm -f /usr/local/bin/terraform
                log_success "$(t 'IaC araçları kaldırıldı.' 'IaC tools removed.')"
            fi
            ;;
        all)
            if confirm "$(t 'DİKKAT: Tüm DevOps araçları kaldırılacak. Emin misiniz?' 'WARNING: All DevOps tools will be removed. Are you sure?')":; then
                remove_target docker
                remove_target k8s
                remove_target iac
                log_success "$(t 'Tüm DevOps araçları kaldırıldı.' 'All DevOps tools removed.')"
            fi
            ;;
    esac
}

# =============================================================================
# INTERACTIVE MENU
# =============================================================================
interactive_menu() {
    show_status
    echo -e "${BOLD}$(t 'Hangi DevOps ortamını yapılandırmak istiyorsunuz?' 'Which DevOps environment would you like to configure?')${NC}"
    echo "  1) Docker (Docker CLI, Compose, Lazydocker, ctop)"
    echo "  2) Kubernetes (kubectl, helm, k9s)"
    echo "  3) IaC & Automation (Terraform, Ansible)"
    echo "  4) Cloud CLI (AWS CLI)"
    echo "  5) $(t 'Hepsini Kur (Tam DevOps Yığını)' 'Install Everything (Full Stack)')"
    echo "  6) $(t 'Kurulu Olanları Güncelle (Update)' 'Update Installed Environments')"
    echo "  7) $(t 'Çıkış' 'Exit')"
    echo ""
    read -p "$(t 'Seçiminiz [1-7]: ' 'Your choice [1-7]: ')" choice

    case "$choice" in
        1) install_docker ;;
        2) install_k8s ;;
        3) install_iac ;;
        4) install_cloud ;;
        5) install_all ;;
        6) update_target all ;;
        7|q|Q) exit 0 ;;
        *) echo "$(t 'Geçersiz seçim.' 'Invalid choice.')"; exit 1 ;;
    esac
}

# =============================================================================
# ENTRYPOINT
# =============================================================================
ACTION="${1:-menu}"
TARGET="${2:-}"

case "$ACTION" in
    status|list|read)
        show_status
        ;;
    install|create)
        case "$TARGET" in
            docker) install_docker ;;
            k8s|kubernetes) install_k8s ;;
            iac|terraform|ansible) install_iac ;;
            cloud|aws) install_cloud ;;
            all|"") install_all ;;
            *) log_error "$(t 'Bilinmeyen hedef:' 'Unknown target:') $TARGET (docker, k8s, iac, cloud, all)"; exit 1 ;;
        esac
        ;;
    update)
        update_target "$TARGET"
        ;;
    remove|delete|purge)
        remove_target "$TARGET"
        ;;
    help|--help|-h)
        echo "$(t 'Kullanım:' 'Usage:') taaos-devops [status|install|update|remove] [docker|k8s|iac|cloud|all] [--lang=tr|en]"
        ;;
    menu|*)
        interactive_menu
        ;;
esac
