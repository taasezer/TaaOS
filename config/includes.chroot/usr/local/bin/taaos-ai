#!/bin/bash
# =============================================================================
# TaaOS AI & Data Science Suite — Modular CRUD Engine
# =============================================================================
# Isolated virtual environment (~/.taaos/ai-env) for PyTorch, Pandas,
# JupyterLab, and Ollama management. Never pollutes system Python.
# Usage: taaos-ai [status|install|update|remove|shell] [target] [--lang=tr|en]
# =============================================================================

set -e

AI_ENV_DIR="$HOME/.taaos/ai-env"
LIB_DIR="/usr/local/lib/taaos"
if [ ! -f "${LIB_DIR}/common.sh" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "${SCRIPT_DIR}/../lib/taaos/common.sh" ]; then
        LIB_DIR="${SCRIPT_DIR}/../lib/taaos"
    fi
fi

if [ -f "${LIB_DIR}/common.sh" ]; then
    source "${LIB_DIR}/common.sh" "$@"
else
    RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'
    t() { echo "$2"; }
    log_info() { echo -e "${CYAN}[INFO]${NC} $*"; }
    log_success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
    log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
    log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
    taaos_banner() { echo -e "${RED}=== $1 ===${NC}"; }
    is_cmd_installed() { command -v "$1" >/dev/null 2>&1; }
    confirm() { return 0; }
    taaos_apt_install() { sudo apt-get update -qq && sudo apt-get install -y "$@"; }
fi

# =============================================================================
# READ: STATUS REPORT (Bilingual & Educational)
# =============================================================================
show_status() {
    taaos_banner \
        "$(t 'TaaOS Yapay Zeka & Veri Bilimi Laboratuvarı' 'TaaOS AI & Data Science Laboratory')" \
        "$(t 'İzole Sanal Ortam (~/.taaos/ai-env) ve Model Durumu' 'Isolated Virtual Environment (~/.taaos/ai-env) & Model Status')"

    echo -e "${YELLOW}1. $(t 'İzole Yapay Zeka Sanal Ortamı' 'Isolated AI Virtual Environment'):${NC}"
    if [ -f "${AI_ENV_DIR}/bin/python" ]; then
        echo -e "  ${GREEN}[✓]${NC} $(t 'Sanal Ortam (venv)' 'Virtualenv (venv)'): ${GREEN}$(t 'Aktif' 'Active')${NC} (${AI_ENV_DIR})"
        
        # Check PyTorch
        local torch_info
        torch_info=$("${AI_ENV_DIR}/bin/python" -c "
try:
    import torch
    cuda = 'CUDA Aktif' if torch.cuda.is_available() else 'CPU Modu'
    print(f'PyTorch {torch.__version__} ({cuda})')
except ImportError:
    print('None')
" 2>/dev/null || echo "Error")
        if [[ "$torch_info" != "None" && "$torch_info" != "Error" ]]; then
            echo -e "  ${GREEN}[✓]${NC} PyTorch: $torch_info"
            echo -e "      ${DIM}└─ $(t 'Derin öğrenme ve tensör hesaplama motoru (Meta AI)' 'Deep learning and GPU tensor computation framework by Meta')${NC}"
        else
            echo -e "  ${RED}[○]${NC} PyTorch: $(t 'Yüklü değil' 'Not installed')"
        fi

        # Check Pandas/Scikit
        local ml_info
        ml_info=$("${AI_ENV_DIR}/bin/python" -c "
try:
    import pandas, sklearn
    print(f'Pandas {pandas.__version__}, Scikit-learn {sklearn.__version__}')
except ImportError:
    print('None')
" 2>/dev/null || echo "Error")
        if [[ "$ml_info" != "None" && "$ml_info" != "Error" ]]; then
            echo -e "  ${GREEN}[✓]${NC} $(t 'Veri Bilimi' 'Data Science'): $ml_info"
            echo -e "      ${DIM}└─ $(t 'Veri manipülasyonu, istatistik ve klasik makine öğrenimi algoritmaları' 'Data manipulation, statistics and classical machine learning algorithms')${NC}"
        else
            echo -e "  ${RED}[○]${NC} $(t 'Veri Bilimi Yığını' 'Data Science Stack'): $(t 'Yüklü değil' 'Not installed')"
        fi

        # Check JupyterLab
        if [ -f "${AI_ENV_DIR}/bin/jupyter-lab" ]; then
            echo -e "  ${GREEN}[✓]${NC} JupyterLab: $(t 'Kurulu' 'Installed') (${AI_ENV_DIR}/bin/jupyter-lab)"
            echo -e "      ${DIM}└─ $(t 'Etkileşimli web tabanlı veri analiz ve prototipleme defteri' 'Interactive web-based data science and prototyping notebook')${NC}"
        else
            echo -e "  ${RED}[○]${NC} JupyterLab: $(t 'Yüklü değil' 'Not installed')"
        fi
    else
        echo -e "  ${RED}[○]${NC} $(t 'AI Sanal Ortamı: Kurulu değil (Kurmak için: taaos-ai install env)' 'AI Virtualenv: Not created (To install: taaos-ai install env)')"
    fi

    echo -e "\n${YELLOW}2. $(t 'Ollama Yerel Model Servisi' 'Ollama Local Model Server'):${NC}"
    if is_cmd_installed ollama; then
        echo -e "  ${GREEN}[✓]${NC} Ollama: $(t 'Kurulu' 'Installed') ($(command -v ollama))"
        echo -e "      ${DIM}└─ $(t 'Llama, Gemma, DeepSeek modellerini yerel donanımda çalıştıran inference motoru' 'Inference engine to run Llama, Gemma, DeepSeek models on local hardware')${NC}"
        if systemctl is-active --quiet ollama 2>/dev/null; then
            echo -e "  ${GREEN}[●]${NC} $(t 'Ollama Servisi: Aktif çalışıyor' 'Ollama Service: Running')"
        else
            echo -e "  ${YELLOW}[○]${NC} $(t 'Ollama Servisi: Durdurulmuş (Başlat: sudo systemctl start ollama)' 'Ollama Service: Stopped (Start: sudo systemctl start ollama)')"
        fi
        local models
        models=$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}' | tr '\n' ', ' | sed 's/,$//')
        if [ -n "$models" ]; then
            echo -e "  ${CYAN}[MODELS]${NC} $(t 'Yüklü Modeller:' 'Installed Models:') $models"
        else
            echo -e "  ${DIM}[MODELS] $(t 'Henüz indirilmiş model yok.' 'No downloaded models yet.')${NC}"
        fi
    else
        echo -e "  ${RED}[○]${NC} Ollama: $(t 'Kurulu değil' 'Not installed')"
    fi

    echo ""
}

# =============================================================================
# CREATE: INSTALLERS
# =============================================================================
ensure_base_python() {
    if ! is_cmd_installed python3 || ! is_cmd_installed python3-venv; then
        log_info "$(t 'Sistem Python venv paketleri kuruluyor...' 'Installing system Python venv packages...')"
        taaos_apt_install python3 python3-venv python3-pip
    fi
}

install_env() {
    ensure_base_python
    log_info "$(t 'İzole AI sanal ortamı oluşturuluyor:' 'Creating isolated AI virtualenv at:') $AI_ENV_DIR"
    mkdir -p "$(dirname "$AI_ENV_DIR")"
    python3 -m venv "$AI_ENV_DIR"
    "${AI_ENV_DIR}/bin/pip" install --upgrade pip wheel setuptools
    log_success "$(t 'AI sanal ortamı hazır!' 'AI virtualenv is ready!')"
}

install_torch() {
    [ ! -f "${AI_ENV_DIR}/bin/python" ] && install_env
    log_info "$(t 'PyTorch izole sanal ortama kuruluyor...' 'Installing PyTorch into isolated virtualenv...')"
    "${AI_ENV_DIR}/bin/pip" install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu || \
    "${AI_ENV_DIR}/bin/pip" install torch torchvision torchaudio
    log_success "$(t 'PyTorch başarıyla kuruldu!' 'PyTorch installed successfully!')"
}

install_datascience() {
    [ ! -f "${AI_ENV_DIR}/bin/python" ] && install_env
    log_info "$(t 'Veri bilimi kütüphaneleri kuruluyor (numpy, pandas, scipy, scikit-learn, matplotlib)...' 'Installing data science libraries (numpy, pandas, scipy, scikit-learn, matplotlib)...')"
    "${AI_ENV_DIR}/bin/pip" install numpy pandas scipy scikit-learn matplotlib seaborn
    log_success "$(t 'Veri bilimi araçları hazır!' 'Data science tools are ready!')"
}

install_jupyter() {
    [ ! -f "${AI_ENV_DIR}/bin/python" ] && install_env
    log_info "$(t 'JupyterLab kuruluyor...' 'Installing JupyterLab...')"
    "${AI_ENV_DIR}/bin/pip" install jupyterlab ipywidgets
    
    # Create desktop shortcut launcher script
    sudo tee /usr/local/bin/taaos-jupyter >/dev/null << JUPYTER_EOF
#!/bin/bash
source "${AI_ENV_DIR}/bin/activate"
exec jupyter-lab "\$@"
JUPYTER_EOF
    sudo chmod +x /usr/local/bin/taaos-jupyter
    log_success "$(t 'JupyterLab hazır! Başlatmak için: taaos-jupyter' 'JupyterLab is ready! Launch command: taaos-jupyter')"
}

install_ollama() {
    log_info "$(t 'Ollama yerel yapay zeka servisi kuruluyor...' 'Installing Ollama local AI server...')"
    if ! is_cmd_installed ollama; then
        curl -fsSL https://ollama.com/install.sh | sh
        sudo systemctl enable ollama 2>/dev/null || true
        sudo systemctl start ollama 2>/dev/null || true
        log_success "$(t 'Ollama servisi hazır!' 'Ollama service is ready!')"
    else
        log_warn "$(t 'Ollama zaten kurulu.' 'Ollama is already installed.')"
    fi
}

install_all() {
    log_info "$(t 'Tam AI Laboratuvarı kuruluyor...' 'Installing full AI Laboratory suite...')"
    install_env
    install_torch
    install_datascience
    install_jupyter
    install_ollama
    log_success "$(t 'Tüm Yapay Zeka laboratuvar araçları hazır!' 'All AI Laboratory tools installed successfully!')"
}

# =============================================================================
# UPDATE: UPDATERS
# =============================================================================
update_all() {
    log_info "$(t 'AI ortamı güncelleniyor...' 'Updating AI environment...')"
    if [ -f "${AI_ENV_DIR}/bin/pip" ]; then
        "${AI_ENV_DIR}/bin/pip" install --upgrade pip wheel setuptools
        "${AI_ENV_DIR}/bin/pip" list --outdated --format=freeze | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 "${AI_ENV_DIR}/bin/pip" install -U 2>/dev/null || true
    fi
    if is_cmd_installed ollama; then
        curl -fsSL https://ollama.com/install.sh | sh 2>/dev/null || true
    fi
    log_success "$(t 'AI araçları güncellendi.' 'AI tools updated.')"
}

# =============================================================================
# DELETE: UNINSTALLERS
# =============================================================================
remove_all() {
    if confirm "$(t 'İzole AI sanal ortamını (~/.taaos/ai-env) tamamen silmek istiyor musunuz?' 'Do you want to completely remove the isolated AI virtualenv (~/.taaos/ai-env)?')"; then
        rm -rf "$AI_ENV_DIR"
        sudo rm -f /usr/local/bin/taaos-jupyter
        log_success "$(t 'AI sanal ortamı silindi.' 'AI virtualenv removed.')"
    fi
}

# =============================================================================
# SHELL: ENTER VIRTUALENV
# =============================================================================
enter_shell() {
    if [ -f "${AI_ENV_DIR}/bin/activate" ]; then
        log_info "$(t 'AI Sanal Ortamına geçiş yapılıyor (Çıkmak için: deactivate veya exit)...' 'Entering AI Virtualenv (Type deactivate or exit to leave)...')"
        exec bash --rcfile <(echo "source ~/.bashrc; source ${AI_ENV_DIR}/bin/activate; echo -e '${GREEN}[AI-ENV AKTİF]${NC}'")
    else
        log_error "$(t 'AI sanal ortamı kurulu değil. Önce taaos-ai install env çalıştırın.' 'AI virtualenv is not installed. Run taaos-ai install env first.')"
        exit 1
    fi
}

# =============================================================================
# INTERACTIVE MENU
# =============================================================================
interactive_menu() {
    show_status
    echo -e "${BOLD}$(t 'Hangi AI bileşenini yapılandırmak istiyorsunuz?' 'Which AI component would you like to configure?')${NC}"
    echo "  1) $(t 'İzole Sanal Ortamı Oluştur (~/.taaos/ai-env)' 'Create Isolated Virtualenv (~/.taaos/ai-env)')"
    echo "  2) PyTorch (Meta Deep Learning)"
    echo "  3) Data Science (NumPy, Pandas, Scikit-learn, Matplotlib)"
    echo "  4) JupyterLab (Interactive Notebooks)"
    echo "  5) Ollama (Local LLM Inference Engine)"
    echo "  6) $(t 'Hepsini Kur (Tam AI Laboratuvarı)' 'Install Everything (Full AI Lab)')"
    echo "  7) $(t 'AI Sanal Ortam Kabuğuna Gir (Shell)' 'Enter AI Environment Shell')"
    echo "  8) $(t 'Kurulu Olanları Güncelle (Update)' 'Update Installed Environments')"
    echo "  9) $(t 'AI Sanal Ortamını Sil (Remove)' 'Remove AI Virtualenv')"
    echo "  0) $(t 'Çıkış' 'Exit')"
    echo ""
    read -p "$(t 'Seçiminiz [0-9]: ' 'Your choice [0-9]: ')" choice

    case "$choice" in
        1) install_env ;;
        2) install_torch ;;
        3) install_datascience ;;
        4) install_jupyter ;;
        5) install_ollama ;;
        6) install_all ;;
        7) enter_shell ;;
        8) update_all ;;
        9) remove_all ;;
        0|q|Q) exit 0 ;;
        *) echo "$(t 'Geçersiz seçim.' 'Invalid choice.')"; exit 1 ;;
    esac
}

# =============================================================================
# ENTRYPOINT
# =============================================================================
ACTION="${1:-menu}"
TARGET="${2:-}"

case "$ACTION" in
    status|list|read)
        show_status
        ;;
    install|create)
        case "$TARGET" in
            env|venv) install_env ;;
            torch|pytorch) install_torch ;;
            data|datascience|pandas) install_datascience ;;
            jupyter|jupyterlab) install_jupyter ;;
            ollama) install_ollama ;;
            all|"") install_all ;;
            *) log_error "$(t 'Bilinmeyen hedef:' 'Unknown target:') $TARGET (env, torch, data, jupyter, ollama, all)"; exit 1 ;;
        esac
        ;;
    shell|activate)
        enter_shell
        ;;
    update)
        update_all
        ;;
    remove|delete|purge)
        remove_all
        ;;
    help|--help|-h)
        echo "$(t 'Kullanım:' 'Usage:') taaos-ai [status|install|update|remove|shell] [env|torch|data|jupyter|ollama|all] [--lang=tr|en]"
        ;;
    menu|*)
        interactive_menu
        ;;
esac
