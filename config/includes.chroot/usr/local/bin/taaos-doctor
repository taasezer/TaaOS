#!/bin/bash
# =============================================================================
# TaaOS System Doctor — Comprehensive Health & Modular Suite Report
# =============================================================================

set -e

GREEN='\033[1;32m'
RED='\033[1;31m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# Locale / Language detection
TAAOS_LANG="en"
_SYS_LOCALE="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
if [[ "$_SYS_LOCALE" =~ ^tr ]]; then
    TAAOS_LANG="tr"
fi
for arg in "$@"; do
    case "$arg" in
        --lang=tr) TAAOS_LANG="tr" ;;
        --lang=en) TAAOS_LANG="en" ;;
    esac
done

t() {
    if [ "$TAAOS_LANG" = "tr" ]; then
        echo -e "$1"
    else
        echo -e "$2"
    fi
}

IS_WSL=false
if [ -f /proc/sys/fs/binfmt_misc/WSLCommandLine ] || grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
fi

echo -e "${RED}==============================================${NC}"
echo -e "${BOLD}  $(t 'TaaOS Sistem Doktoru & Modül Durum Raporu' 'TaaOS System Doctor & Module Health Report')${NC}"
if [ "$IS_WSL" = true ]; then
    echo -e "  ${CYAN}[$(t 'Ortam: WSL2 (Terminal Sürümü - Sıfır Yük)' 'Environment: WSL2 (Terminal Edition - Lightweight)')]${NC}"
else
    echo -e "  ${CYAN}[$(t 'Ortam: TaaOS Bağımsız Linux İşletim Sistemi' 'Environment: TaaOS Standalone Linux OS')]${NC}"
fi
echo -e "${RED}==============================================${NC}"
echo ""

# 1. Disk
echo -e "${YELLOW}[DISK]${NC}"
df -h / | tail -1 | awk -v tr_used="$(t 'Kullanılan' 'Used')" -v tr_full="$(t 'dolu' 'full')" '{printf "  %s: %s / %s (%s %s)\n", tr_used, $3, $2, $5, tr_full}'
DISK_PCT=$(df / | tail -1 | awk '{gsub(/%/,""); print $5}')
if [ "$DISK_PCT" -gt 90 ]; then
    echo -e "  ${RED}⚠ $(t 'DİKKAT: Disk %90'\''dan fazla dolu!' 'WARNING: Root disk is over 90% full!')${NC}"
elif [ "$DISK_PCT" -gt 75 ]; then
    echo -e "  ${YELLOW}⚠ $(t 'Disk %75'\''ten fazla dolu' 'Disk usage is over 75%')${NC}"
else
    echo -e "  ${GREEN}✓ $(t 'Disk durumu iyi' 'Disk health is optimal')${NC}"
fi

# 2. RAM
echo -e "\n${YELLOW}[RAM]${NC}"
free -h | awk -v tr_used="$(t 'Kullanılan' 'Used')" '/Mem:/ {printf "  %s: %s / %s\n", tr_used, $3, $2}'
free | awk -v lang="$TAAOS_LANG" '/Mem:/ {
    pct=int($3/$2*100);
    if(pct>90) {
        if(lang=="tr") printf "  \033[1;31m⚠ RAM %%90+ kullanımda!\033[0m\n";
        else printf "  \033[1;31m⚠ High RAM usage (90%+)\033[0m\n";
    } else {
        if(lang=="tr") printf "  \033[1;32m✓ RAM durumu iyi (%%%d)\033[0m\n", pct;
        else printf "  \033[1;32m✓ RAM health optimal (%d%%)\033[0m\n", pct;
    }
}'

# 3. CPU Load
echo -e "\n${YELLOW}[CPU]${NC}"
LOAD=$(cat /proc/loadavg | awk '{print $1}')
CORES=$(nproc)
echo "  $(t 'Yük:' 'Load:') $LOAD ($CORES $(t 'çekirdek' 'cores'))"
if (( $(awk "BEGIN {print ($LOAD > $CORES) ? 1 : 0}") )); then
    echo -e "  ${RED}⚠ $(t 'CPU aşırı yük altında!' 'High CPU load detected!')${NC}"
else
    echo -e "  ${GREEN}✓ $(t 'CPU durumu iyi' 'CPU load normal')${NC}"
fi

# 4. Services
echo -e "\n${YELLOW}[$(t 'SERVİSLER' 'SERVICES')]${NC}"
if [ "$IS_WSL" = true ]; then
    echo -e "  ${GREEN}●${NC} $(t 'WSL2 Çekirdek Köprüsü: Aktif' 'WSL2 Subsystem: Active')"
    if systemctl is-active docker 2>/dev/null | grep -q "active"; then
        echo -e "  ${GREEN}●${NC} Docker: $(t 'aktif' 'active')"
    fi
else
    for svc in ufw ollama docker NetworkManager earlyoom; do
        if systemctl is-enabled "$svc" 2>/dev/null | grep -q "enabled"; then
            STATUS=$(systemctl is-active "$svc" 2>/dev/null)
            if [ "$STATUS" = "active" ]; then
                echo -e "  ${GREEN}●${NC} $svc: $(t 'aktif' 'active')"
            else
                echo -e "  ${YELLOW}○${NC} $svc: $STATUS"
            fi
        fi
    done
fi

# 5. Updates
echo -e "\n${YELLOW}[$(t 'GÜNCELLEMELER' 'UPDATES')]${NC}"
UPDATES=$(apt-get -s upgrade 2>/dev/null | grep -c "^Inst" || echo "0")
if [ "$UPDATES" -gt 0 ]; then
    echo -e "  ${YELLOW}⚠ $(t "$UPDATES güncelleme bekliyor" "$UPDATES updates pending")${NC}"
    echo -e "  $(t 'Çalıştır:' 'Run:') ${CYAN}taaos-update${NC}"
else
    echo -e "  ${GREEN}✓ $(t 'Sistem güncel' 'System is up to date')${NC}"
fi

# 6. TaaNOS (AI Engine)
echo -e "\n${YELLOW}[TAANOS - AI ENGINE]${NC}"
if [ "$IS_WSL" = true ]; then
    echo -e "  ${CYAN}ℹ${NC} $(t 'WSL2 Modu: TaaNOS çekirdeği ana Windows host üzerinde çalışır.' 'WSL2 Mode: TaaNOS runs natively on host Windows terminal.')"
else
    if [ -x /usr/local/bin/taanos ]; then
        TAANOS_VER=$(taanos version 2>/dev/null | head -1 || echo "v1.5.0")
        echo -e "  ${GREEN}✓${NC} TaaNOS: $TAANOS_VER"
    else
        echo -e "  ${RED}✗ $(t 'TaaNOS ikili dosyası bulunamadı!' 'TaaNOS binary not found!')${NC}"
        echo -e "  $(t 'Çalıştır:' 'Run:') ${CYAN}taaos-update${NC}"
    fi

    if systemctl is-active --quiet ollama 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} Ollama: $(t 'aktif' 'active')"
    elif is_cmd_installed ollama; then
        echo -e "  ${YELLOW}○${NC} Ollama: $(t 'yüklü ama servis durdurulmuş' 'installed but service stopped')"
    else
        echo -e "  ${YELLOW}○${NC} Ollama: $(t 'kurulu değil (Çalıştır: taaos-ai install ollama)' 'not installed (Run: taaos-ai install ollama)')"
    fi
fi

# 7. Modular Developer Suite Status
echo -e "\n${YELLOW}[$(t 'MODÜLER GELİŞTİRİCİ YIĞINI (ON-DEMAND SUITE)' 'MODULAR DEVELOPER SUITE (ON-DEMAND)')]${NC}"

# Backend
backend_items=()
command -v python3 >/dev/null 2>&1 && backend_items+=("Python")
command -v node >/dev/null 2>&1 && backend_items+=("Node")
command -v go >/dev/null 2>&1 && backend_items+=("Go")
command -v rustc >/dev/null 2>&1 && backend_items+=("Rust")
command -v psql >/dev/null 2>&1 && backend_items+=("Postgres-CLI")

if [ ${#backend_items[@]} -gt 0 ]; then
    echo -e "  ${GREEN}[✓]${NC} Backend: ${GREEN}$(t 'Aktif' 'Active')${NC} (${backend_items[*]})"
else
    echo -e "  ${RED}[○]${NC} Backend: ${DIM}$(t 'Kurulu değil' 'Not installed')${NC} ($(t 'Kurmak için:' 'To install:') ${CYAN}taaos-backend${NC})"
fi

# Frontend
frontend_items=()
command -v bun >/dev/null 2>&1 && frontend_items+=("Bun")
command -v pnpm >/dev/null 2>&1 && frontend_items+=("pnpm")
command -v yarn >/dev/null 2>&1 && frontend_items+=("Yarn")
command -v tailwindcss >/dev/null 2>&1 && frontend_items+=("Tailwind")

if [ ${#frontend_items[@]} -gt 0 ]; then
    echo -e "  ${GREEN}[✓]${NC} Frontend: ${GREEN}$(t 'Aktif' 'Active')${NC} (${frontend_items[*]})"
else
    echo -e "  ${RED}[○]${NC} Frontend: ${DIM}$(t 'Kurulu değil' 'Not installed')${NC} ($(t 'Kurmak için:' 'To install:') ${CYAN}taaos-frontend${NC})"
fi

# DevOps
devops_items=()
command -v docker >/dev/null 2>&1 && devops_items+=("Docker")
command -v kubectl >/dev/null 2>&1 && devops_items+=("Kubectl")
command -v helm >/dev/null 2>&1 && devops_items+=("Helm")
command -v k9s >/dev/null 2>&1 && devops_items+=("k9s")
command -v terraform >/dev/null 2>&1 && devops_items+=("Terraform")
command -v ansible >/dev/null 2>&1 && devops_items+=("Ansible")

if [ ${#devops_items[@]} -gt 0 ]; then
    echo -e "  ${GREEN}[✓]${NC} DevOps: ${GREEN}$(t 'Aktif' 'Active')${NC} (${devops_items[*]})"
else
    echo -e "  ${RED}[○]${NC} DevOps: ${DIM}$(t 'Kurulu değil' 'Not installed')${NC} ($(t 'Kurmak için:' 'To install:') ${CYAN}taaos-devops${NC})"
fi

# AI Lab
if [ -d "$HOME/.taaos/ai-env" ]; then
    echo -e "  ${GREEN}[✓]${NC} AI Lab: ${GREEN}$(t 'Aktif' 'Active')${NC} (~/.taaos/ai-env)"
else
    echo -e "  ${RED}[○]${NC} AI Lab: ${DIM}$(t 'Kurulu değil' 'Not installed')${NC} ($(t 'Kurmak için:' 'To install:') ${CYAN}taaos-ai${NC})"
fi

# Linux Dev
if [ -d "/lib/modules/$(uname -r)/build" ] || command -v perf >/dev/null 2>&1; then
    echo -e "  ${GREEN}[✓]${NC} Linux Stack: ${GREEN}$(t 'Aktif' 'Active')${NC}"
else
    echo -e "  ${RED}[○]${NC} Linux Stack: ${DIM}$(t 'Kurulu değil' 'Not installed')${NC} ($(t 'Kurmak için:' 'To install:') ${CYAN}taaos-linux${NC})"
fi

# 8. Uptime & System
echo -e "\n${YELLOW}[$(t 'SİSTEM' 'SYSTEM')]${NC}"
echo "  Uptime: $(uptime -p 2>/dev/null | sed 's/up //' || uptime)"
echo "  Kernel: $(uname -r)"

echo ""
echo -e "${RED}==============================================${NC}"
echo -e "  $(t 'Rapor zamanı:' 'Report time:') $(date '+%Y-%m-%d %H:%M:%S')"
echo -e "${RED}==============================================${NC}"
