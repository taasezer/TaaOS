#!/bin/bash
# =============================================================================
# TaaOS Update and Self-Healing Utility
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}==============================================${NC}"
echo -e "${GREEN}      TaaOS System Updater & Healer           ${NC}"
echo -e "${GREEN}==============================================${NC}"

# Check for root
if [ "$EUID" -ne 0 ]; then
  echo -e "${RED}[ERROR] Please run this command as root (sudo taaos-update)${NC}"
  exit 1
fi

echo -e "\n${YELLOW}[1/4] Healing Broken Packages...${NC}"
dpkg --configure -a || true
apt-get install -f -y || true

echo -e "\n${YELLOW}[2/4] Updating System Packages...${NC}"
apt-get update
apt-get upgrade -y
apt-get autoremove -y
apt-get clean

echo -e "\n${YELLOW}[3/4] Checking for TaaOS Core Fixes from GitHub...${NC}"
# In the future, this can clone the user's specific patch repository
# For now, we simulate fetching the latest OS patches
REPO_URL="https://raw.githubusercontent.com/taaos/patches/main/latest.sh"
echo "Connecting to TaaOS update servers..."
if curl --output /dev/null --silent --head --fail "$REPO_URL"; then
    echo "Downloading and applying latest patches..."
    curl -sL "$REPO_URL" | bash
else
    echo -e "${GREEN}No new core patches found. Core system is up to date.${NC}"
fi

echo -e "\n${YELLOW}[4/4] Verifying Natural Engine Health...${NC}"
if systemctl is-active --quiet ollama; then
    echo -e "${GREEN}Natural Engine (Ollama) is running correctly.${NC}"
else
    echo -e "${RED}Natural Engine is stopped. Attempting to start...${NC}"
    systemctl start ollama || echo -e "${RED}Failed to start ollama service.${NC}"
fi

echo -e "\n${GREEN}==============================================${NC}"
echo -e "${GREEN}✓ System Healing & Update Complete!           ${NC}"
echo -e "${GREEN}==============================================${NC}"
