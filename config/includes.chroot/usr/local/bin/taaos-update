#!/bin/bash
# =============================================================================
# TaaOS System Updater
# =============================================================================

GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}==============================================${NC}"
echo -e "${GREEN}  TaaOS Sistem Güncelleyici${NC}"
echo -e "${CYAN}==============================================${NC}"
echo ""

echo -e "${YELLOW}[1/3] APT Paketleri Güncelleniyor...${NC}"
sudo apt update && sudo apt upgrade -y

echo -e "\n${YELLOW}[2/3] Gereksiz APT Paketleri Temizleniyor...${NC}"
sudo apt autoremove -y && sudo apt clean

if command -v flatpak >/dev/null 2>&1; then
    echo -e "\n${YELLOW}[3/3] Flatpak Uygulamaları Güncelleniyor...${NC}"
    flatpak update -y
else
    echo -e "\n${YELLOW}[3/3] Flatpak yüklü değil, atlanıyor.${NC}"
fi

echo -e "\n${GREEN}✓ Güncelleme tamamlandı! Sisteminiz en güncel sürümde.${NC}"
