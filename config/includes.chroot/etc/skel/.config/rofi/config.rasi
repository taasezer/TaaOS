/* ===================================================================
 * TaaOS Modern Application Launcher (Rofi Theme)
 * Accent: Rosso Corsa Red (#D40000) | Background: Translucent Graphite (#0D1117EE)
 * =================================================================== */

configuration {
    modi: "drun,run,window";
    font: "Fira Sans Medium 11";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: " Applications";
    display-run: " Run";
    display-window: " Window";
    drun-display-format: "{name}";
    disable-history: false;
    terminal: "xfce4-terminal";
}

* {
    bg-col:  #0d1117ee;
    bg-col-light: #161b22;
    border-col: #d40000;
    selected-col: #21262d;
    blue: #58a6ff;
    fg-col: #f0f6fc;
    fg-col2: #8b949e;
    rosso: #d40000;
    width: 600;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @rosso;
    border-radius: 12px;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 6px 12px;
    margin: 16px 16px 8px 16px;
}

prompt {
    background-color: @rosso;
    padding: 4px 10px;
    text-color: #ffffff;
    border-radius: 6px;
    margin: 0px 8px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 4px 0px;
    margin: 0px 0px 0px 4px;
    text-color: @fg-col;
    background-color: transparent;
    placeholder: "Search applications, dev tools, or system utilities...";
    placeholder-color: @fg-col2;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 16px 16px;
    margin: 10px 0px 0px 0px;
    columns: 2;
    lines: 7;
    background-color: @bg-col;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 8px;
    margin: 2px 4px;
}

element-icon {
    size: 24px;
    margin: 0px 8px 0px 0px;
}

element selected {
    background-color: @rosso;
    text-color: #ffffff;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px 12px;
    background-color: @bg-col-light;
    text-color: @fg-col2;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @rosso;
    text-color: #ffffff;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 16px 0px 0px 16px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}
